---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LearningDashboard from '../components/LearningDashboard';
---
<BaseLayout title="Thành tích học tập – Trạng Toán" description="Theo dõi lượt luyện, chuỗi ngày học, điểm số và kỹ năng cần củng cố trên Trạng Toán.">
  <SiteHeader compact />
  <main class="min-h-[70vh] bg-gradient-to-br from-indigo-50/70 via-white to-sky-50/70 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 py-12 md:py-16 transition-colors">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <div class="mb-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-200/80 bg-amber-50/80 px-3.5 py-1 text-xs font-black uppercase tracking-wider text-amber-800 dark:border-amber-500/20 dark:bg-amber-400/10 dark:text-amber-300">
          <span>🏆</span>
          <span>Bảng vàng tích lũy</span>
        </div>
        <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white md:text-5xl">Thành tích học tập</h1>
        <p class="mt-3 max-w-2xl text-base font-medium leading-relaxed text-slate-600 dark:text-slate-400">
          Toàn bộ kết quả và số lượng sao đạt được được lưu an toàn trực tiếp trên thiết bị này, không cần đăng nhập.
        </p>
      </div>
      <LearningDashboard client:load />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
