---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PracticeModuleCard from '../components/PracticeModuleCard.astro';
import { grade1PracticeModules, grade1PracticeModes, getGrade1ModulesBySemester } from '../data/grade1Curriculum';
const sections = [
  { eyebrow: 'Học kỳ I', title: 'Nền tảng Toán học đầu tiên', description: 'Số đến 10, hình phẳng, phép cộng trừ và vị trí trong không gian.', modules: getGrade1ModulesBySemester(1), accent: 'text-violet-700', dot: 'bg-violet-500', background: 'bg-white', hover: 'group-hover:bg-violet-600' },
  { eyebrow: 'Học kỳ II', title: 'Mở rộng số học và kỹ năng thực tế', description: 'Số đến 100, đo độ dài, tính toán và xem thời gian.', modules: getGrade1ModulesBySemester(2), accent: 'text-sky-700', dot: 'bg-sky-500', background: 'bg-slate-50', hover: 'group-hover:bg-sky-600' },
];
---
<BaseLayout title="Toán lớp 1 – Trạng Toán" description="Mười nhóm luyện tập Toán lớp 1 trực quan, bám sát nội dung học trên lớp và sách giáo khoa.">
  <SiteHeader compact />
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-violet-50 via-white to-sky-50">
      <div class="absolute inset-0 opacity-35 [background-image:radial-gradient(#a78bfa_1px,transparent_1px)] [background-size:28px_28px]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 md:px-8 lg:grid-cols-[1fr_380px] lg:py-20">
        <div><div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white px-4 py-2 text-sm font-black text-violet-700 shadow-sm">🐿️ Chương trình luyện tập lớp 1</div><h1 class="mt-6 text-4xl font-black tracking-[-0.04em] text-slate-950 md:text-6xl">Bắt đầu hành trình <span class="text-violet-600">yêu Toán</span></h1><p class="mt-5 max-w-3xl text-lg font-medium leading-8 text-slate-600">Chọn đúng nội dung đang học để luyện thêm. Bé có thể mở bất kỳ mục nào và không cần hoàn thành theo thứ tự.</p><div class="mt-7 flex flex-wrap gap-3"><span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm">✓ {grade1PracticeModules.length} mục đã mở</span><span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm">✓ Hai học kỳ</span><span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm">✓ Câu hỏi ngẫu nhiên</span></div><a href="#hoc-ky-1" class="mt-8 inline-flex items-center gap-3 rounded-2xl bg-violet-600 px-6 py-4 font-black text-white shadow-xl shadow-violet-200 transition hover:-translate-y-1 hover:bg-violet-700">Chọn bài để luyện <span>↓</span></a></div>
        <div class="hidden lg:block"><div class="rounded-[2rem] border-4 border-white bg-white p-5 shadow-2xl"><div class="flex items-center justify-between"><div><p class="text-sm font-black text-violet-700">Toán lớp 1</p><p class="mt-1 text-xl font-black text-slate-900">Mỗi ngày một bước nhỏ</p></div><span class="text-5xl">🐿️</span></div><div class="mt-5 grid grid-cols-2 gap-3">{grade1PracticeModes.map((mode) => <div class="rounded-2xl bg-slate-50 p-4"><span class="text-2xl">{mode.icon}</span><p class="mt-2 text-sm font-black text-slate-800">{mode.title}</p><p class="mt-1 text-xs font-semibold text-slate-500">{mode.questionCount} câu · {mode.estimatedMinutes} phút</p></div>)}</div></div></div>
      </div>
    </section>
    {sections.map((section, index) => <section id={index === 0 ? 'hoc-ky-1' : 'hoc-ky-2'} class={`py-14 ${section.background}`}><div class="mx-auto max-w-7xl px-4 md:px-8"><div class="flex items-start gap-4"><span class={`mt-2 h-12 w-1.5 rounded-full ${section.dot}`}></span><div><p class={`text-sm font-extrabold tracking-[0.14em] ${section.accent}`}>{section.eyebrow}</p><h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">{section.title}</h2><p class="mt-2 font-medium text-slate-500">{section.description}</p></div></div><div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">{section.modules.map((practiceModule) => <PracticeModuleCard practiceModule={practiceModule} grade={1} accent={section.hover} />)}</div></div></section>)}
  </main>
  <SiteFooter />
</BaseLayout>
