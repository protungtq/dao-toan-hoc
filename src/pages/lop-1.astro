---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PracticeModuleCard from '../components/PracticeModuleCard.astro';
import {
  grade1PracticeModules,
  grade1PracticeModes,
  getGrade1ModulesBySemester,
} from '../data/grade1Curriculum';

const sections = [
  { eyebrow: 'Học kỳ I', title: 'Nền tảng Toán học đầu tiên', description: 'Số đến 10, hình phẳng, phép cộng trừ và vị trí trong không gian.', modules: getGrade1ModulesBySemester(1), accent: 'text-violet-700', dot: 'bg-violet-500', background: 'bg-white', hover: 'group-hover:bg-violet-600' },
  { eyebrow: 'Học kỳ II', title: 'Mở rộng số học và kỹ năng thực tế', description: 'Số đến 100, đo độ dài, tính toán và xem thời gian.', modules: getGrade1ModulesBySemester(2), accent: 'text-sky-700', dot: 'bg-sky-500', background: 'bg-slate-50', hover: 'group-hover:bg-sky-600' },
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Chương trình Luyện tập Toán lớp 1',
  description: 'Hệ thống 10 chủ đề Toán lớp 1 trực quan sinh động với các hoạt động tương tác, phát triển tư duy số học, hình học và đo lường.',
  provider: {
    '@type': 'Organization',
    name: 'Trạng Toán',
    url: 'https://trangtoan.com',
  },
  educationalLevel: 'Lớp 1 (Tiểu học)',
  inLanguage: 'vi',
};
---
<BaseLayout title="Toán lớp 1 – 10 Chủ đề Luyện tập Trực quan & Sinh động – Trạng Toán" description="Mười nhóm luyện tập Toán lớp 1 trực quan sinh động, phát triển tư duy tự nhiên với gợi ý từng bước dễ hiểu.">
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <SiteHeader compact />
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-indigo-50/70 via-white to-sky-50/70 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200/80 dark:border-slate-800 transition-colors">
      <div class="absolute inset-0 opacity-25 [background-image:radial-gradient(#6366f1_1px,transparent_1px)] [background-size:28px_28px] dark:opacity-10"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 md:px-8 lg:grid-cols-[1fr_380px] lg:py-16">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200/80 bg-white/90 px-4 py-1.5 text-xs sm:text-sm font-black text-indigo-700 shadow-xs backdrop-blur dark:border-indigo-500/20 dark:bg-indigo-950/40 dark:text-indigo-300">
            <img src="/models/grade-mascots/1-compact.webp" alt="" aria-hidden="true" width="28" height="28" class="h-7 w-7 object-contain drop-shadow-sm" />
            Toán lớp 1 · Học Toán trực quan & hứng thú
          </div>
          <h1 class="mt-6 text-4xl font-black tracking-[-0.04em] text-slate-950 dark:text-white md:text-6xl">
            Bắt đầu hành trình <span class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent dark:from-indigo-400 dark:to-violet-400">yêu Toán</span>
          </h1>
          <p class="mt-5 max-w-3xl text-base sm:text-lg font-medium leading-relaxed text-slate-600 dark:text-slate-300">
            Hệ thống bài tập toán trực quan sinh động theo từng chủ đề của Lớp 1. Bé làm quen với số học, hình học và đo lường thông qua các hoạt động tương tác, có gợi ý tư duy từng bước nhẹ nhàng.
          </p>
          <div class="mt-7 flex flex-wrap gap-2.5">
            <span class="rounded-xl bg-white/90 dark:bg-slate-800/90 px-3.5 py-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300 shadow-xs border border-indigo-100 dark:border-indigo-900/50">
              🌟 10 chủ đề học kỳ I & học kỳ II
            </span>
            <span class="rounded-xl bg-white/90 dark:bg-slate-800/90 px-3.5 py-1.5 text-xs font-bold text-sky-700 dark:text-sky-300 shadow-xs border border-sky-100 dark:border-sky-900/50">
              🎮 Trò chơi trực quan & tương tác
            </span>
            <span class="rounded-xl bg-white/90 dark:bg-slate-800/90 px-3.5 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 shadow-xs border border-emerald-100 dark:border-emerald-900/50">
              💡 Gợi ý tư duy 3 bước dễ hiểu
            </span>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#hoc-ky-1" class="inline-flex items-center gap-2.5 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 px-6 py-3.5 text-sm font-black text-white shadow-lg shadow-indigo-600/20 transition-all hover:-translate-y-0.5 hover:from-indigo-500 hover:to-violet-500 active:scale-98">
              <span>Chọn bài để luyện</span>
              <span>↓</span>
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <div class="rounded-[2.25rem] border border-slate-200/80 bg-white/90 p-6 shadow-xl backdrop-blur-md dark:border-slate-800 dark:bg-slate-900/90">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-black uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Toán lớp 1</p>
                <p class="mt-1 text-lg font-black text-slate-900 dark:text-white">Mỗi ngày một bước nhỏ</p>
              </div>
              <img src="/models/grade-mascots/1-compact.webp" alt="" aria-hidden="true" width="88" height="88" class="h-20 w-20 object-contain drop-shadow-md" />
            </div>
            <div class="mt-5 grid grid-cols-2 gap-2.5">
              {grade1PracticeModes.map((mode) => (
                <div class="rounded-2xl border border-slate-200/70 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-800/50">
                  <span class="text-2xl">{mode.icon}</span>
                  <p class="mt-2 text-sm font-black text-slate-900 dark:text-white">{mode.title}</p>
                  <p class="mt-0.5 text-xs font-semibold text-slate-500 dark:text-slate-400">{mode.questionCount} câu · {mode.estimatedMinutes} phút</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {sections.map((section, index) => (
      <section id={index === 0 ? 'hoc-ky-1' : 'hoc-ky-2'} class={`py-14 ${section.background}`}>
        <div class="mx-auto max-w-7xl px-4 md:px-8">
          <div class="flex items-start gap-4">
            <span class={`mt-2 h-12 w-1.5 rounded-full ${section.dot}`}></span>
            <div>
              <p class={`text-sm font-extrabold tracking-[0.14em] ${section.accent}`}>{section.eyebrow}</p>
              <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">{section.title}</h2>
              <p class="mt-2 font-medium text-slate-500">{section.description}</p>
            </div>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {section.modules.map((practiceModule) => (
              <PracticeModuleCard practiceModule={practiceModule} grade={1} accent={section.hover} />
            ))}
          </div>
        </div>
      </section>
    ))}

    {/* HƯỚNG DẪN ĐỒNG HÀNH CÙNG CON */}
    <section class="border-t border-slate-200/80 bg-gradient-to-b from-slate-50 to-white dark:from-slate-900/40 dark:to-slate-950 py-16 md:py-20 transition-colors">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center max-w-2xl mx-auto">
          <span class="inline-flex items-center gap-2 rounded-full border border-indigo-200/70 bg-indigo-50/80 px-4 py-1.5 text-xs font-black uppercase tracking-wider text-indigo-700 dark:border-indigo-400/20 dark:bg-indigo-950/40 dark:text-indigo-300">
            🌱 Đồng hành cùng con
          </span>
          <h2 class="mt-4 text-3xl font-black text-slate-950 dark:text-white md:text-4xl">
            Phương Pháp Học Toán Nhẹ Nhàng & Hiệu Quả
          </h2>
          <p class="mt-3 text-base font-medium leading-relaxed text-slate-600 dark:text-slate-400">
            Trạng Toán được thiết kế giúp các bạn nhỏ lớp 1 tiếp cận Toán học như một trò chơi khám phá, nuôi dưỡng niềm say mê tự nhiên.
          </p>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          <div class="rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <span class="text-3xl">🧸</span>
            <h3 class="mt-4 text-lg font-black text-slate-900 dark:text-white">1. Học qua hình ảnh trực quan</h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-400">
              Mỗi khái niệm số và hình học đều gắn với các hình ảnh cụ thể như que tính, ngón tay, quả táo, con vật, giúp con dễ dàng liên tưởng thay vì học vẹt.
            </p>
          </div>

          <div class="rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <span class="text-3xl">🧩</span>
            <h3 class="mt-4 text-lg font-black text-slate-900 dark:text-white">2. Rèn luyện tư duy đếm hình</h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-400">
              Hướng dẫn con quan sát kỹ càng: đếm các hình đơn trước rồi tìm hình ghép lớn bên ngoài để không bao giờ bị sót hình trong các bài toán hình học.
            </p>
          </div>

          <div class="rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <span class="text-3xl">💡</span>
            <h3 class="mt-4 text-lg font-black text-slate-900 dark:text-white">3. Gợi ý 3 bước thông minh</h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-400">
              Khi con chưa chọn đúng, hệ thống đưa ra 3 bước gợi ý tư duy tự nhiên để con tự suy ngẫm và tìm ra đáp án, tạo sự tự tin và nhớ lâu.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>


