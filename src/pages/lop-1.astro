---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PracticeModuleCard from '../components/PracticeModuleCard.astro';
import {
  grade1PracticeModules,
  grade1PracticeModes,
  getGrade1ModulesBySemester,
  grade1TextbookComparison,
} from '../data/grade1Curriculum';

const sections = [
  { eyebrow: 'Học kỳ I', title: 'Nền tảng Toán học đầu tiên', description: 'Số đến 10, hình phẳng, phép cộng trừ và vị trí trong không gian.', modules: getGrade1ModulesBySemester(1), accent: 'text-violet-700', dot: 'bg-violet-500', background: 'bg-white', hover: 'group-hover:bg-violet-600' },
  { eyebrow: 'Học kỳ II', title: 'Mở rộng số học và kỹ năng thực tế', description: 'Số đến 100, đo độ dài, tính toán và xem thời gian.', modules: getGrade1ModulesBySemester(2), accent: 'text-sky-700', dot: 'bg-sky-500', background: 'bg-slate-50', hover: 'group-hover:bg-sky-600' },
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Chương trình Luyện tập Toán lớp 1 Chuẩn SGK Kết nối tri thức với cuộc sống',
  description: 'Hệ thống 10 chủ đề Toán lớp 1 trực quan bám sát bộ sách giáo khoa GDPT 2018 Kết nối tri thức với cuộc sống (Tập 1 & Tập 2 - NXB Giáo dục Việt Nam), có chú thích số trang và dạng bài cụ thể.',
  provider: {
    '@type': 'Organization',
    name: 'Trạng Toán',
    url: 'https://trangtoan.com',
  },
  educationalLevel: 'Lớp 1 (Tiểu học)',
  inLanguage: 'vi',
};
---
<BaseLayout title="Toán lớp 1 – Chuẩn SGK Kết nối tri thức với cuộc sống – Trạng Toán" description="Mười nhóm luyện tập Toán lớp 1 trực quan, bám sát nội dung và số trang sách giáo khoa Toán 1 Kết nối tri thức với cuộc sống (Tập 1 & Tập 2).">
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <SiteHeader compact />
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-violet-50 via-white to-sky-50">
      <div class="absolute inset-0 opacity-35 [background-image:radial-gradient(#a78bfa_1px,transparent_1px)] [background-size:28px_28px]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 md:px-8 lg:grid-cols-[1fr_380px] lg:py-20">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white px-4 py-2 text-sm font-black text-violet-700 shadow-sm">
            <img src="/models/grade-mascots/1-compact.webp" alt="" aria-hidden="true" width="32" height="32" class="h-8 w-8 object-contain drop-shadow-md" />
            Toán lớp 1 · Sách Kết nối tri thức với cuộc sống
          </div>
          <h1 class="mt-6 text-4xl font-black tracking-[-0.04em] text-slate-950 md:text-6xl">
            Bắt đầu hành trình <span class="text-violet-600">yêu Toán</span>
          </h1>
          <p class="mt-5 max-w-3xl text-lg font-medium leading-8 text-slate-600">
            Hệ thống bài tập bám sát từng trang sách giáo khoa <b>Toán 1 – Kết nối tri thức với cuộc sống</b> (NXB Giáo dục Việt Nam). Bé luyện đúng bài đang học trên lớp, có chú thích số trang Tập 1 & Tập 2 và gợi ý từng bước.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-sky-800 shadow-sm border border-sky-100">
              📘 Toán 1 Tập 1: Bài 1 đến Bài 14 (Trang 6 – 124)
            </span>
            <span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-sky-800 shadow-sm border border-sky-100">
              📘 Toán 1 Tập 2: Bài 15 đến Bài 28 (Trang 6 – 128)
            </span>
            <span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-violet-700 shadow-sm border border-violet-100">
              ✓ Chú thích số trang SGK KNTT trong từng câu
            </span>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#hoc-ky-1" class="inline-flex items-center gap-3 rounded-2xl bg-violet-600 px-6 py-4 font-black text-white shadow-xl shadow-violet-200 transition hover:-translate-y-1 hover:bg-violet-700">
              Chọn bài để luyện <span>↓</span>
            </a>
            <a href="#doi-chieu-sgk" class="inline-flex items-center gap-2 rounded-2xl border-2 border-violet-200 bg-white px-6 py-4 font-black text-violet-700 shadow-sm transition hover:bg-violet-50">
              📖 Tra cứu số trang SGK KNTT
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <div class="rounded-[2rem] border-4 border-white bg-white p-5 shadow-2xl">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-black text-violet-700">Toán lớp 1 KNTT</p>
                <p class="mt-1 text-xl font-black text-slate-900">Mỗi ngày một bước nhỏ</p>
              </div>
              <img src="/models/grade-mascots/1-compact.webp" alt="" aria-hidden="true" width="88" height="88" class="h-[5.5rem] w-[5.5rem] object-contain drop-shadow-xl" />
            </div>
            <div class="mt-5 grid grid-cols-2 gap-3">
              {grade1PracticeModes.map((mode) => (
                <div class="rounded-2xl bg-slate-50 p-4">
                  <span class="text-2xl">{mode.icon}</span>
                  <p class="mt-2 text-sm font-black text-slate-800">{mode.title}</p>
                  <p class="mt-1 text-xs font-semibold text-slate-500">{mode.questionCount} câu · {mode.estimatedMinutes} phút</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {sections.map((section, index) => (
      <section id={index === 0 ? 'hoc-ky-1' : 'hoc-ky-2'} class={`py-14 ${section.background}`}>
        <div class="mx-auto max-w-7xl px-4 md:px-8">
          <div class="flex items-start gap-4">
            <span class={`mt-2 h-12 w-1.5 rounded-full ${section.dot}`}></span>
            <div>
              <p class={`text-sm font-extrabold tracking-[0.14em] ${section.accent}`}>{section.eyebrow}</p>
              <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">{section.title}</h2>
              <p class="mt-2 font-medium text-slate-500">{section.description}</p>
            </div>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {section.modules.map((practiceModule) => (
              <PracticeModuleCard practiceModule={practiceModule} grade={1} accent={section.hover} />
            ))}
          </div>
        </div>
      </section>
    ))}

    {/* BẢNG ĐỐI CHIẾU SÁCH GIÁO KHOA TOÁN 1 KẾT NỐI TRI THỨC VỚI CUỘC SỐNG */}
    <section id="doi-chieu-sgk" class="border-t border-slate-200 bg-gradient-to-b from-slate-50 to-white py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <span class="inline-flex items-center gap-2 rounded-full bg-sky-100 px-4 py-1.5 text-xs font-black uppercase tracking-wider text-sky-800">
            📖 NXB Giáo dục Việt Nam · GDPT 2018
          </span>
          <h2 class="mt-4 text-3xl font-black text-slate-950 md:text-4xl">
            Bảng Tra Cứu Bài Học Theo SGK Toán 1 (Kết Nối Tri Thức)
          </h2>
          <p class="mt-3 text-base font-medium leading-relaxed text-slate-600">
            Đối chiếu chi tiết từng chủ đề luyện tập trên website với bài học và số trang trong <b>Toán 1 Tập 1</b> và <b>Toán 1 Tập 2</b> bộ sách <i>Kết nối tri thức với cuộc sống</i> (Tổng chủ biên: GS. TSKH. Hà Huy Khoái).
          </p>
        </div>

        {/* Cấu trúc 2 tập sách SGK KNTT */}
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <div class="rounded-3xl border-2 border-sky-200 bg-sky-50/70 p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-sky-600 text-xl text-white font-black">1</span>
              <div>
                <h3 class="text-lg font-black text-sky-950">Toán 1 – Tập 1 (Học kỳ I)</h3>
                <p class="text-xs font-bold text-sky-700">Bài 1 đến Bài 14 · Trang 6 đến Trang 124</p>
              </div>
            </div>
            <p class="mt-4 text-sm font-medium leading-relaxed text-slate-700">
              Bao gồm 5 chủ đề nền tảng: Các số từ 0 đến 10 (Bài 1–5), Vị trí và hình phẳng (Bài 6–8), Phép cộng phép trừ trong phạm vi 10 (Bài 9–11), Khối lập phương và khối hộp chữ nhật (Bài 12), Ôn tập học kỳ 1 (Bài 13–14).
            </p>
          </div>

          <div class="rounded-3xl border-2 border-indigo-200 bg-indigo-50/70 p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-indigo-600 text-xl text-white font-black">2</span>
              <div>
                <h3 class="text-lg font-black text-indigo-950">Toán 1 – Tập 2 (Học kỳ II)</h3>
                <p class="text-xs font-bold text-indigo-700">Bài 15 đến Bài 28 · Trang 6 đến Trang 128</p>
              </div>
            </div>
            <p class="mt-4 text-sm font-medium leading-relaxed text-slate-700">
              Bao gồm 5 chủ đề mở rộng: Các số đến 100 (Bài 15–18), Độ dài và đơn vị đo xăng-ti-mét cm (Bài 19–20), Phép cộng trừ không nhớ trong phạm vi 100 (Bài 21–23), Thời gian – Giờ và lịch (Bài 24–25), Ôn tập cuối năm (Bài 26–28).
            </p>
          </div>
        </div>

        {/* Bảng tra cứu đối chiếu chi tiết 10 chủ đề */}
        <div class="mt-10 overflow-hidden rounded-3xl border-2 border-slate-200 bg-white shadow-xl">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm md:text-base border-collapse">
              <thead class="border-b-2 border-slate-200 bg-slate-100/80 text-slate-900 font-black">
                <tr>
                  <th class="p-4 md:p-5">Chủ đề luyện tập</th>
                  <th class="p-4 md:p-5 bg-sky-50/70 text-sky-950 border-x border-sky-100">
                    📘 Vị trí trong SGK Toán 1 KNTT
                  </th>
                  <th class="p-4 md:p-5">Trọng tâm kiến thức & Dạng bài SGK</th>
                  <th class="p-4 md:p-5 text-center">Thực hành</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                {grade1TextbookComparison.map((item) => (
                  <tr class="hover:bg-slate-50/80 transition">
                    <td class="p-4 md:p-5">
                      <div class="flex items-center gap-3">
                        <span class="text-2xl">{item.icon}</span>
                        <div>
                          <p class="font-black text-slate-950 text-base">{item.moduleTitle}</p>
                          <span class="inline-block mt-0.5 rounded bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-600">
                            Học kỳ {item.semester} · Toán 1 Tập {item.kntt.volume}
                          </span>
                        </div>
                      </div>
                    </td>
                    <td class="p-4 md:p-5 bg-sky-50/30 border-x border-sky-100 min-w-56">
                      <span class="inline-block rounded-md bg-sky-100 px-2.5 py-1 text-xs font-black text-sky-800">
                        {item.kntt.pages}
                      </span>
                      <p class="mt-1.5 font-bold text-slate-900 text-xs md:text-sm">{item.kntt.lesson}</p>
                      <p class="mt-1 text-xs text-slate-500 leading-relaxed">{item.kntt.description}</p>
                    </td>
                    <td class="p-4 md:p-5 max-w-md">
                      <p class="text-xs font-bold text-slate-800 mb-1">Mục tiêu sư phạm:</p>
                      <p class="text-xs text-slate-600 leading-relaxed">{item.pedagogicalFocus}</p>
                      <div class="mt-2 space-y-1">
                        {item.sgkExerciseForms.slice(0, 3).map((form) => (
                          <div class="text-[11px] font-semibold text-slate-600 flex items-start gap-1">
                            <span class="text-emerald-600">✓</span> <span>{form}</span>
                          </div>
                        ))}
                      </div>
                    </td>
                    <td class="p-4 md:p-5 text-center">
                      <a
                        href={`/luyen-tap/lop-1/${item.slug}`}
                        class="inline-flex items-center gap-1 rounded-xl bg-violet-600 px-4 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-violet-700 whitespace-nowrap"
                      >
                        Luyện bài <span>→</span>
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Hướng dẫn phụ huynh */}
        <div class="mt-10 rounded-3xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm">
          <h3 class="text-lg font-black text-slate-900 flex items-center gap-2">
            <span>💡</span> Hướng dẫn phụ huynh cách kèm con luyện tập theo SGK Kết nối tri thức
          </h3>
          <div class="mt-4 grid gap-5 sm:grid-cols-3 text-sm text-slate-600 font-medium">
            <div class="rounded-2xl bg-slate-50 p-4 border border-slate-100">
              <p class="font-black text-slate-900">1. Nhìn số trang trên góc câu hỏi</p>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
                Ở mỗi câu hỏi luyện tập trên web, góc trên đều có chú thích nhỏ như: <code class="font-bold text-violet-700">📖 SGK KNTT Tập 1 – Trang 48 (Bài 7)</code>. Bố mẹ mở sách đúng trang đó để xem lại ví dụ mẫu và bài tập của thầy cô.
              </p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4 border border-slate-100">
              <p class="font-black text-slate-900">2. Đếm hình ghép đúng phương pháp</p>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
                Khi gặp bài toán đếm hình (như ngôi nhà, thuyền, ô tô), nhắc con đếm từng hình đơn trước, sau đó tìm các hình ghép lớn bao quanh để không bị sót đáp án (như ô cửa sổ 4 hình vuông nhỏ ghép thành 1 hình vuông lớn = 5 hình).
              </p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4 border border-slate-100">
              <p class="font-black text-slate-900">3. Sử dụng 3 bước gợi ý từng bước</p>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
                Nếu bé chọn chưa đúng, hệ thống đưa ra 3 bước gợi ý tư duy tự nhiên mà không đưa đáp án ngay, giúp con tự khám phá và ghi nhớ kiến thức lâu dài.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>


