---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PracticeModuleCard from '../components/PracticeModuleCard.astro';
import {
  grade1PracticeModules,
  grade1PracticeModes,
  getGrade1ModulesBySemester,
} from '../data/grade1Curriculum';

const sections = [
  { eyebrow: 'Học kỳ I', title: 'Nền tảng Toán học đầu tiên', description: 'Số đến 10, hình phẳng, phép cộng trừ và vị trí trong không gian.', modules: getGrade1ModulesBySemester(1), accent: 'text-violet-700', dot: 'bg-violet-500', background: 'bg-white', hover: 'group-hover:bg-violet-600' },
  { eyebrow: 'Học kỳ II', title: 'Mở rộng số học và kỹ năng thực tế', description: 'Số đến 100, đo độ dài, tính toán và xem thời gian.', modules: getGrade1ModulesBySemester(2), accent: 'text-sky-700', dot: 'bg-sky-500', background: 'bg-slate-50', hover: 'group-hover:bg-sky-600' },
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Chương trình Luyện tập Toán lớp 1',
  description: 'Hệ thống 10 chủ đề Toán lớp 1 trực quan sinh động với các hoạt động tương tác, phát triển tư duy số học, hình học và đo lường.',
  provider: {
    '@type': 'Organization',
    name: 'Trạng Toán',
    url: 'https://trangtoan.com',
  },
  educationalLevel: 'Lớp 1 (Tiểu học)',
  inLanguage: 'vi',
};
---
<BaseLayout title="Toán lớp 1 – 10 Chủ đề Luyện tập Trực quan & Sinh động – Trạng Toán" description="Mười nhóm luyện tập Toán lớp 1 trực quan sinh động, phát triển tư duy tự nhiên với gợi ý từng bước dễ hiểu.">
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <SiteHeader compact />
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-violet-50 via-white to-sky-50">
      <div class="absolute inset-0 opacity-35 [background-image:radial-gradient(#a78bfa_1px,transparent_1px)] [background-size:28px_28px]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 md:px-8 lg:grid-cols-[1fr_380px] lg:py-20">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white px-4 py-2 text-sm font-black text-violet-700 shadow-sm">
            <img src="/models/grade-mascots/1-compact.webp" alt="" aria-hidden="true" width="32" height="32" class="h-8 w-8 object-contain drop-shadow-md" />
            Toán lớp 1 · Học Toán trực quan & hứng thú
          </div>
          <h1 class="mt-6 text-4xl font-black tracking-[-0.04em] text-slate-950 md:text-6xl">
            Bắt đầu hành trình <span class="text-violet-600">yêu Toán</span>
          </h1>
          <p class="mt-5 max-w-3xl text-lg font-medium leading-8 text-slate-600">
            Hệ thống bài tập toán trực quan sinh động theo từng chủ đề của Lớp 1. Bé làm quen với số học, hình học và đo lường thông qua các hoạt động tương tác, có gợi ý tư duy từng bước nhẹ nhàng.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-violet-700 shadow-sm border border-violet-100">
              🌟 10 chủ đề học kỳ I & học kỳ II
            </span>
            <span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-sky-800 shadow-sm border border-sky-100">
              🎮 Trò chơi trực quan & tương tác
            </span>
            <span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-emerald-700 shadow-sm border border-emerald-100">
              💡 Gợi ý tư duy 3 bước dễ hiểu
            </span>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#hoc-ky-1" class="inline-flex items-center gap-3 rounded-2xl bg-violet-600 px-6 py-4 font-black text-white shadow-xl shadow-violet-200 transition hover:-translate-y-1 hover:bg-violet-700">
              Chọn bài để luyện <span>↓</span>
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <div class="rounded-[2rem] border-4 border-white bg-white p-5 shadow-2xl">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-black text-violet-700">Toán lớp 1</p>
                <p class="mt-1 text-xl font-black text-slate-900">Mỗi ngày một bước nhỏ</p>
              </div>
              <img src="/models/grade-mascots/1-compact.webp" alt="" aria-hidden="true" width="88" height="88" class="h-[5.5rem] w-[5.5rem] object-contain drop-shadow-xl" />
            </div>
            <div class="mt-5 grid grid-cols-2 gap-3">
              {grade1PracticeModes.map((mode) => (
                <div class="rounded-2xl bg-slate-50 p-4">
                  <span class="text-2xl">{mode.icon}</span>
                  <p class="mt-2 text-sm font-black text-slate-800">{mode.title}</p>
                  <p class="mt-1 text-xs font-semibold text-slate-500">{mode.questionCount} câu · {mode.estimatedMinutes} phút</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {sections.map((section, index) => (
      <section id={index === 0 ? 'hoc-ky-1' : 'hoc-ky-2'} class={`py-14 ${section.background}`}>
        <div class="mx-auto max-w-7xl px-4 md:px-8">
          <div class="flex items-start gap-4">
            <span class={`mt-2 h-12 w-1.5 rounded-full ${section.dot}`}></span>
            <div>
              <p class={`text-sm font-extrabold tracking-[0.14em] ${section.accent}`}>{section.eyebrow}</p>
              <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">{section.title}</h2>
              <p class="mt-2 font-medium text-slate-500">{section.description}</p>
            </div>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {section.modules.map((practiceModule) => (
              <PracticeModuleCard practiceModule={practiceModule} grade={1} accent={section.hover} />
            ))}
          </div>
        </div>
      </section>
    ))}

    {/* HƯỚNG DẪN ĐỒNG HÀNH CÙNG CON */}
    <section class="border-t border-slate-200 bg-gradient-to-b from-slate-50 to-white py-16 md:py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center max-w-2xl mx-auto">
          <span class="inline-flex items-center gap-2 rounded-full bg-violet-100 px-4 py-1.5 text-xs font-black uppercase tracking-wider text-violet-800">
            🌱 Đồng hành cùng con
          </span>
          <h2 class="mt-4 text-3xl font-black text-slate-950 md:text-4xl">
            Phương Pháp Học Toán Nhẹ Nhàng & Hiệu Quả
          </h2>
          <p class="mt-3 text-base font-medium leading-relaxed text-slate-600">
            Trạng Toán được thiết kế giúp các bạn nhỏ lớp 1 tiếp cận Toán học như một trò chơi khám phá, nuôi dưỡng niềm say mê tự nhiên.
          </p>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <span class="text-3xl">🧸</span>
            <h3 class="mt-3 text-lg font-black text-slate-900">1. Học qua hình ảnh trực quan</h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600">
              Mỗi khái niệm số và hình học đều gắn với các hình ảnh cụ thể như que tính, ngón tay, quả táo, con vật, giúp con dễ dàng liên tưởng thay vì học vẹt.
            </p>
          </div>

          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <span class="text-3xl">🧩</span>
            <h3 class="mt-3 text-lg font-black text-slate-900">2. Rèn luyện tư duy đếm hình</h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600">
              Hướng dẫn con quan sát kỹ càng: đếm các hình đơn trước rồi tìm hình ghép lớn bên ngoài để không bao giờ bị sót hình trong các bài toán hình học.
            </p>
          </div>

          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <span class="text-3xl">💡</span>
            <h3 class="mt-3 text-lg font-black text-slate-900">3. Gợi ý 3 bước thông minh</h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600">
              Khi con chưa chọn đúng, hệ thống đưa ra 3 bước gợi ý tư duy tự nhiên để con tự suy ngẫm và tìm ra đáp án, tạo sự tự tin và nhớ lâu.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>


