---
import BaseLayout from '../layouts/BaseLayout.astro';
import { grade1PracticeModules } from '../data/grade1Curriculum';
import { grade2PracticeModules } from '../data/grade2Curriculum';

const learningPaths = [
  {
    grade: 1, title: 'Toán lớp 1', href: '/lop-1', icon: '1', mascot: '🐿️',
    description: 'Xây nền tảng số học, phép tính, hình học và đo lường.',
    modules: grade1PracticeModules,
    ready: grade1PracticeModules.filter((item) => item.developmentStatus === 'ready').length,
    gradient: 'from-violet-500 via-purple-500 to-indigo-600', light: 'bg-violet-50', border: 'border-violet-200', text: 'text-violet-700', shadow: 'shadow-violet-200/70',
  },
  {
    grade: 2, title: 'Toán lớp 2', href: '/lop-2', icon: '2', mascot: '🐻',
    description: 'Luyện tính có nhớ, nhân chia, số đến 1 000 và dữ liệu.',
    modules: grade2PracticeModules,
    ready: grade2PracticeModules.filter((item) => item.developmentStatus === 'ready').length,
    gradient: 'from-cyan-400 via-sky-500 to-blue-600', light: 'bg-cyan-50', border: 'border-cyan-200', text: 'text-cyan-700', shadow: 'shadow-cyan-200/70',
  },
];

const upcomingGrades = [
  { icon: '3', title: 'Toán lớp 3', href: '/lop-3', description: 'Nhân chia, số đến 100 000, hình học và đo lường.', color: 'from-emerald-400 to-teal-500', text: 'text-emerald-700', light: 'bg-emerald-50', border: 'border-emerald-200' },
  { icon: '4', title: 'Toán lớp 4', href: '/lop-4', description: 'Số lớn, phân số, trung bình cộng và hình học.', color: 'from-orange-400 to-amber-500', text: 'text-orange-700', light: 'bg-orange-50', border: 'border-orange-200' },
  { icon: '5', title: 'Toán lớp 5', href: '/lop-5', description: 'Số thập phân, tỉ số, phần trăm, diện tích và thể tích.', color: 'from-pink-400 to-rose-500', text: 'text-rose-700', light: 'bg-rose-50', border: 'border-rose-200' },
];
---

<BaseLayout title="Trạng Toán – Luyện Toán tiểu học lớp 1–5" description="Website luyện tập Toán lớp 1 đến lớp 5 với câu hỏi trực quan, sinh động và bám sát nội dung học trên lớp.">
  <header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 md:px-8">
      <a href="/" class="flex items-center gap-3">
        <div class="relative grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-rose-600 to-red-800 text-xl font-black text-white shadow-lg shadow-rose-200"><span class="absolute -right-1 -top-1 h-3 w-3 rounded-full border-2 border-white bg-amber-400"></span>T</div>
        <div><p class="text-lg font-black tracking-tight text-slate-950">Trạng Toán</p><p class="text-xs font-bold text-slate-500">Luyện mỗi ngày · Giỏi từng bước</p></div>
      </a>
      <nav class="hidden items-center gap-1 md:flex">
        <a href="#chon-lop" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-rose-50 hover:text-rose-700">Chọn lớp</a>
        <a href="#ban-do" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-rose-50 hover:text-rose-700">Bản đồ bài học</a>
        <a href="#phu-huynh" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-rose-50 hover:text-rose-700">Phụ huynh</a>
      </nav>
      <a href="#chon-lop" class="rounded-xl bg-rose-700 px-5 py-3 text-sm font-black text-white shadow-lg shadow-rose-200 transition hover:-translate-y-0.5 hover:bg-rose-800">Chọn bài học</a>
    </div>
  </header>

  <main class="overflow-hidden">
    <section class="relative bg-[#fbfcff]">
      <div class="absolute -left-36 top-16 h-96 w-96 rounded-full bg-amber-200/50 blur-3xl"></div>
      <div class="absolute -right-32 top-0 h-[28rem] w-[28rem] rounded-full bg-rose-200/45 blur-3xl"></div>
      <div class="absolute inset-0 opacity-40 [background-image:radial-gradient(#94a3b8_1px,transparent_1px)] [background-size:28px_28px]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 py-16 md:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:py-24">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-white px-4 py-2 text-sm font-extrabold text-amber-800 shadow-sm"><span class="text-lg">⭐</span>Chương trình Toán tiểu học lớp 1–5</div>
          <h1 class="mt-7 max-w-3xl text-5xl font-black leading-[1.08] tracking-[-0.045em] text-slate-950 md:text-7xl">Luyện từng bước, <span class="bg-gradient-to-r from-rose-700 via-orange-500 to-amber-500 bg-clip-text text-transparent">chinh phục từng bài Toán.</span></h1>
          <p class="mt-6 max-w-2xl text-lg font-medium leading-8 text-slate-600 md:text-xl">Chọn đúng nội dung đang học, nhận gợi ý khi gặp khó và tích lũy thành tích trên hành trình trở thành Trạng Toán.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#chon-lop" class="group flex items-center justify-center gap-3 rounded-2xl bg-rose-700 px-7 py-4 font-black text-white shadow-xl shadow-rose-200 transition hover:-translate-y-1 hover:bg-rose-800"><span class="text-2xl">🏅</span><span>Chọn lớp để luyện</span><span class="transition group-hover:translate-x-1">→</span></a>
            <a href="#ban-do" class="group flex items-center justify-center gap-3 rounded-2xl border-2 border-amber-200 bg-white px-7 py-4 font-black text-amber-800 shadow-lg shadow-amber-100 transition hover:-translate-y-1 hover:border-amber-400"><span class="text-2xl">🗺️</span><span>Xem bản đồ bài học</span></a>
          </div>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-bold text-slate-500"><span>✓ Không quảng cáo</span><span>✓ Không khóa bài</span><span>✓ Tối ưu cho máy tính bảng</span></div>
        </div>

        <div class="relative mx-auto w-full max-w-xl">
          <div class="relative rounded-[2.5rem] border-4 border-white bg-white p-5 shadow-2xl shadow-slate-300/60 md:p-7">
            <div class="flex items-center justify-between"><div><p class="text-sm font-black text-rose-700">Hành trình Trạng Toán</p><p class="mt-1 text-2xl font-black text-slate-950">Hôm nay mình luyện gì?</p></div><div class="flex -space-x-3"><span class="grid h-14 w-14 place-items-center rounded-2xl border-4 border-white bg-orange-100 text-3xl">🐿️</span><span class="grid h-14 w-14 place-items-center rounded-2xl border-4 border-white bg-amber-100 text-3xl">🐻</span></div></div>
            <div class="mt-6 space-y-3">
              <a href="/lop-1" class="group flex items-center gap-4 rounded-3xl bg-gradient-to-r from-violet-50 to-indigo-50 p-4 transition hover:-translate-y-1 hover:shadow-lg"><span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-violet-500 to-indigo-600 text-2xl font-black text-white">1</span><span class="min-w-0 flex-1"><span class="block font-black text-slate-900">Khám phá Toán lớp 1</span><span class="mt-1 block text-sm font-semibold text-slate-500">10 mục đã sẵn sàng</span></span><span class="text-xl text-violet-600 transition group-hover:translate-x-1">→</span></a>
              <a href="/lop-2" class="group flex items-center gap-4 rounded-3xl bg-gradient-to-r from-cyan-50 to-sky-50 p-4 transition hover:-translate-y-1 hover:shadow-lg"><span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-cyan-400 to-blue-600 text-2xl font-black text-white">2</span><span class="min-w-0 flex-1"><span class="block font-black text-slate-900">Khám phá Toán lớp 2</span><span class="mt-1 block text-sm font-semibold text-slate-500">14 chủ đề đang được xây dựng</span></span><span class="text-xl text-sky-600 transition group-hover:translate-x-1">→</span></a>
            </div>
            <div class="mt-5 grid grid-cols-3 gap-3"><div class="rounded-2xl bg-emerald-50 p-4 text-center"><p class="text-2xl font-black text-emerald-700">10</p><p class="mt-1 text-xs font-bold text-emerald-600">Mục đã mở</p></div><div class="rounded-2xl bg-amber-50 p-4 text-center"><p class="text-2xl font-black text-amber-700">⭐</p><p class="mt-1 text-xs font-bold text-amber-600">Thành tích</p></div><div class="rounded-2xl bg-rose-50 p-4 text-center"><p class="text-2xl font-black text-rose-700">3</p><p class="mt-1 text-xs font-bold text-rose-600">Mức gợi ý</p></div></div>
          </div>
          <div class="absolute -bottom-8 -right-8 -z-10 h-full w-full rounded-[2.5rem] bg-gradient-to-br from-amber-200 to-rose-200"></div>
        </div>
      </div>
    </section>

    <section id="chon-lop" class="bg-white py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="text-center"><p class="font-extrabold tracking-[0.16em] text-rose-700">Chọn lớp phù hợp</p><h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 md:text-5xl">Bắt đầu hành trình của bé</h2><p class="mx-auto mt-4 max-w-2xl font-medium leading-7 text-slate-600">Không cần đi theo thứ tự. Bé có thể mở thẳng chủ đề đang học hoặc nội dung cần luyện thêm.</p></div>
        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          {learningPaths.map((path) => (
            <a href={path.href} class={`group relative overflow-hidden rounded-[2rem] border-2 bg-white p-6 shadow-xl transition hover:-translate-y-2 md:p-8 ${path.border} ${path.shadow}`}>
              <div class={`absolute -right-20 -top-24 h-64 w-64 rounded-full bg-gradient-to-br opacity-15 ${path.gradient}`}></div>
              <div class="relative flex items-start justify-between gap-5"><div class="flex items-center gap-4"><span class={`grid h-20 w-20 place-items-center rounded-3xl bg-gradient-to-br text-4xl font-black text-white shadow-xl ${path.gradient}`}>{path.icon}</span><div><p class={`text-sm font-black ${path.text}`}>Chương trình lớp {path.grade}</p><h3 class="mt-1 text-3xl font-black text-slate-950">{path.title}</h3></div></div><span class={`hidden rounded-2xl px-4 py-2 text-sm font-black sm:block ${path.light} ${path.text}`}>{path.ready}/{path.modules.length} mục đã mở</span></div>
              <p class="relative mt-6 max-w-xl text-lg font-medium leading-8 text-slate-600">{path.description}</p>
              <div class="relative mt-6 flex flex-wrap gap-2">{path.modules.slice(0, 5).map((item) => <span class={`rounded-xl border px-3 py-2 text-xs font-bold ${path.light} ${path.border} ${path.text}`}>{item.icon} {item.shortTitle}</span>)}<span class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-bold text-slate-500">+{path.modules.length - 5} mục</span></div>
              <div class="relative mt-7 flex items-center justify-between border-t border-slate-100 pt-5"><span class="flex items-center gap-2 font-bold text-slate-500"><span class="text-2xl">{path.mascot}</span>Đồng hành cùng bé</span><span class={`font-black transition group-hover:translate-x-1 ${path.text}`}>Xem tất cả bài học →</span></div>
            </a>
          ))}
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">{upcomingGrades.map((grade) => <a href={grade.href} class={`group rounded-3xl border-2 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg ${grade.border}`}><div class="flex items-center gap-4"><span class={`grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br text-xl font-black text-white shadow-lg ${grade.color}`}>{grade.icon}</span><div><h3 class="text-lg font-black text-slate-900">{grade.title}</h3><p class={`mt-1 text-xs font-black ${grade.text}`}>Mở chương trình →</p></div></div><p class="mt-4 text-sm font-semibold leading-6 text-slate-500">{grade.description}</p><div class={`mt-4 rounded-xl px-3 py-2 text-center text-xs font-bold ${grade.light} ${grade.text}`}>Các mục luyện tập sẽ được cập nhật dần</div></a>)}</div>
      </div>
    </section>

    <section id="ban-do" class="border-y border-slate-200 bg-slate-50 py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end"><div><p class="font-extrabold tracking-[0.16em] text-sky-600">Bản đồ bài học</p><h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 md:text-5xl">Nhìn rõ hành trình của từng lớp</h2></div><p class="max-w-xl font-medium leading-7 text-slate-600">Mỗi ô là một nhóm kiến thức bám theo sách giáo khoa. Ô có dấu tích đã có thể vào luyện ngay.</p></div>
        <div class="mt-12 space-y-6">
          {learningPaths.map((path) => (
            <article class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
              <div class={`flex flex-col gap-4 bg-gradient-to-r p-6 text-white sm:flex-row sm:items-center sm:justify-between ${path.gradient}`}><div class="flex items-center gap-4"><span class="grid h-14 w-14 place-items-center rounded-2xl bg-white/20 text-2xl font-black backdrop-blur">{path.grade}</span><div><h3 class="text-2xl font-black">Hành trình {path.title}</h3><p class="mt-1 font-semibold text-white/80">{path.modules.length} mục · Hai học kỳ</p></div></div><a href={path.href} class="rounded-xl bg-white px-5 py-3 text-center text-sm font-black text-slate-800 shadow-lg transition hover:-translate-y-0.5">Mở trang lớp {path.grade} →</a></div>
              <div class="grid gap-3 p-5 sm:grid-cols-2 lg:grid-cols-5 lg:p-7">
                {path.modules.map((item) => item.developmentStatus === 'ready' ? (
                  <a href={`/luyen-tap/lop-${path.grade}/${item.slug}`} class="group flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 p-3 transition hover:-translate-y-1 hover:shadow-md"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-emerald-500 text-sm font-black text-white">✓</span><span class="min-w-0"><span class="block text-xs font-black text-emerald-700">Mục {item.number}</span><span class="block truncate text-sm font-black text-slate-800">{item.shortTitle}</span></span></a>
                ) : (
                  <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white text-sm font-black text-slate-400 shadow-sm">{item.number}</span><span class="min-w-0"><span class="block text-xs font-black text-slate-400">Đang xây dựng</span><span class="block truncate text-sm font-black text-slate-600">{item.shortTitle}</span></span></div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-950 py-20 text-white">
      <div class="mx-auto max-w-7xl px-4 md:px-8"><div class="text-center"><p class="font-extrabold tracking-[0.16em] text-violet-400">Một lượt luyện tập</p><h2 class="mt-3 text-3xl font-black tracking-tight md:text-5xl">Đơn giản để trẻ tự học</h2></div><div class="mt-12 grid gap-5 md:grid-cols-3">{[['1','🎯','Chọn đúng chủ đề','Vào thẳng bài đang học hoặc nội dung cần củng cố.'],['2','🧠','Làm câu hỏi sinh động','Quan sát hình, chọn đáp án và nhận gợi ý từng bước.'],['3','📊','Xem kỹ năng cần luyện','Kết quả được chia theo từng nhóm kiến thức cụ thể.']].map(([number,icon,title,description]) => <article class="relative rounded-3xl border border-slate-800 bg-slate-900 p-7"><span class="absolute right-6 top-5 text-5xl font-black text-slate-800">{number}</span><span class="text-4xl">{icon}</span><h3 class="mt-7 text-xl font-black">{title}</h3><p class="mt-3 font-medium leading-7 text-slate-400">{description}</p></article>)}</div></div>
    </section>

    <section id="phu-huynh" class="bg-white py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8"><div class="grid items-center gap-8 overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-violet-600 via-purple-600 to-blue-600 p-8 text-white shadow-2xl shadow-violet-200 md:grid-cols-[1fr_auto] md:p-12"><div><div class="flex items-center gap-3 text-4xl"><span>🐿️</span><span>🐻</span></div><h2 class="mt-5 max-w-3xl text-3xl font-black tracking-tight md:text-5xl">Bổ trợ việc học, không thay thế giáo viên</h2><p class="mt-5 max-w-3xl text-lg font-medium leading-8 text-violet-100">Website giúp trẻ luyện thêm và giúp phụ huynh nhận ra kỹ năng còn yếu. Nội dung giảng dạy chính vẫn dựa trên giáo viên và sách giáo khoa.</p></div><a href="#chon-lop" class="rounded-2xl bg-white px-7 py-4 text-center font-black text-violet-700 shadow-xl transition hover:-translate-y-1">Chọn lớp để bắt đầu</a></div></div>
    </section>
  </main>

  <footer class="border-t border-slate-200 bg-white"><div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-8 text-sm font-semibold text-slate-500 md:flex-row md:items-center md:justify-between md:px-8"><p>© 2026 Trạng Toán</p><div class="flex flex-wrap gap-5">{[1,2,3,4,5].map((grade) => <a href={`/lop-${grade}`} class="hover:text-violet-700">Lớp {grade}</a>)}</div></div></footer>
</BaseLayout>
