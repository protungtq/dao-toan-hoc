---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContinueLearning from '../components/ContinueLearning';
import { grade1PracticeModules } from '../data/grade1Curriculum';
import { grade2PracticeModules } from '../data/grade2Curriculum';
import { grade3PracticeModules } from '../data/grade3Curriculum';
import { grade4PracticeModules } from '../data/grade4Curriculum';
import { grade5PracticeModules } from '../data/grade5Curriculum';

const grade1ReadyModules = grade1PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade2ReadyModules = grade2PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade3ReadyModules = grade3PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade4ReadyModules = grade4PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade5ReadyModules = grade5PracticeModules.filter((item) => item.developmentStatus === 'ready');

const grades = [
  { grade: 1, mascot: '🐰', title: 'Toán lớp 1', short: 'Số và phép tính đầu tiên', description: 'Số đến 100, cộng trừ, hình học, độ dài và thời gian.', count: grade1ReadyModules.length, gradient: 'from-violet-500 to-indigo-600', pale: 'from-violet-50 to-indigo-50', border: 'border-violet-200', text: 'text-violet-700' },
  { grade: 2, mascot: '🐱', title: 'Toán lớp 2', short: 'Tính toán và đo lường', description: 'Cộng trừ có nhớ, nhân chia, số đến 1 000 và dữ liệu.', count: grade2ReadyModules.length, gradient: 'from-cyan-400 to-blue-600', pale: 'from-cyan-50 to-blue-50', border: 'border-cyan-200', text: 'text-sky-700' },
  { grade: 3, mascot: '🐶', title: 'Toán lớp 3', short: 'Nhân chia và số lớn', description: 'Bảng nhân chia, số đến 100 000, hình học và đo lường.', count: grade3ReadyModules.length, gradient: 'from-emerald-400 to-teal-600', pale: 'from-emerald-50 to-teal-50', border: 'border-emerald-200', text: 'text-emerald-700' },
  { grade: 4, mascot: '🐯', title: 'Toán lớp 4', short: 'Số lớn và phân số', description: 'Số có nhiều chữ số, phân số, trung bình cộng và hình học.', count: grade4ReadyModules.length, gradient: 'from-orange-400 to-amber-600', pale: 'from-orange-50 to-amber-50', border: 'border-orange-200', text: 'text-orange-700' },
  { grade: 5, mascot: '🦁', title: 'Toán lớp 5', short: 'Thập phân và tỉ số', description: 'Số thập phân, phần trăm, diện tích, thể tích và chuyển động.', count: grade5ReadyModules.length, gradient: 'from-pink-400 to-rose-600', pale: 'from-pink-50 to-rose-50', border: 'border-rose-200', text: 'text-rose-700' },
];

const quickLessons = [
  { ...grade1ReadyModules[0], grade: 1, gradeColor: 'bg-violet-100 text-violet-700 dark:bg-violet-950/60 dark:text-violet-300' },
  { ...grade2ReadyModules[0], grade: 2, gradeColor: 'bg-sky-100 text-sky-700 dark:bg-sky-950/60 dark:text-sky-300' },
  { ...grade3ReadyModules[0], grade: 3, gradeColor: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300' },
  { ...grade4ReadyModules[0], grade: 4, gradeColor: 'bg-orange-100 text-orange-700 dark:bg-orange-950/60 dark:text-orange-300' },
  { ...grade5ReadyModules[0], grade: 5, gradeColor: 'bg-pink-100 text-pink-700 dark:bg-pink-950/60 dark:text-pink-300' },
].filter((item) => item.slug);

const strengths = [
  { icon: '📘', title: 'Bám sát bài học trên lớp', description: 'Bài tập sắp xếp theo tuần và từng chủ đề quen thuộc, giúp bé củng cố ngay kiến thức vừa học.' },
  { icon: '🧠', title: 'Gợi ý khi gặp bài khó', description: 'Gợi ý mở dần từng nấc giúp bé tự suy nghĩ tìm ra cách làm, kèm lời giải từng bước rõ ràng.' },
  { icon: '🎯', title: 'Nhận biết điểm chưa vững', description: 'Ghi nhận dạng toán bé còn lúng túng để nhắc ôn lại đúng lúc, giúp bé tiến bộ từng ngày.' },
  { icon: '📱', title: 'Tiện học trên mọi thiết bị', description: 'Học mượt mà trên điện thoại, máy tính bảng, máy tính hoặc mở nhanh trên màn hình TV.' },
];
---

<BaseLayout title="Trạng Toán – Luyện Toán tiểu học lớp 1–5" description="Website luyện tập Toán lớp 1 đến lớp 5 với câu hỏi trực quan, gợi ý và lời giải từng bước.">
  <SiteHeader />
  <main class="overflow-hidden">
    <!-- Hero Section -->
    <section class="poster-hero relative overflow-hidden border-b border-emerald-200/70 dark:border-slate-800">
      <div class="absolute inset-0 opacity-[0.16] [background-image:radial-gradient(#64748b_1px,transparent_1px)] [background-size:30px_30px] dark:opacity-[0.08]"></div>
      <div class="absolute -left-36 top-24 h-80 w-80 rounded-full bg-sky-200/45 blur-3xl dark:bg-sky-500/5"></div>
      <div class="absolute -right-32 -top-24 h-[30rem] w-[30rem] rounded-full bg-violet-200/55 blur-3xl dark:bg-violet-500/10"></div>
      
      <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-14 md:px-8 lg:grid-cols-[1.08fr_0.92fr] lg:py-20">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-300 bg-white/85 px-4 py-2 text-sm font-extrabold text-emerald-800 shadow-sm backdrop-blur dark:border-emerald-400/20 dark:bg-emerald-400/10 dark:text-emerald-200">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            Cùng bé tự tin học Toán lớp 1–5
          </div>
          <h1 class="poster-headline mt-6 text-4xl font-black leading-[1.08] tracking-[-0.045em] text-slate-950 sm:text-5xl md:text-6xl dark:text-white">
            Luyện đúng bài,<br />
            <span class="bg-gradient-to-r from-emerald-600 via-teal-500 to-amber-500 bg-clip-text text-transparent">hiểu chắc từng bước</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg font-medium leading-8 text-slate-600 dark:text-slate-300">
            Bài tập vừa sức theo từng bài học trên lớp, có gợi ý khi gặp khó và lời giải từng bước để bé tự tin làm bài.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#chon-lop" class="poster-primary-button inline-flex items-center justify-center gap-3 rounded-2xl px-7 py-4 font-black text-white transition hover:-translate-y-1">
              Chọn lớp đang học <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
            </a>
            <a href="/thanh-tich" class="inline-flex items-center justify-center gap-3 rounded-2xl border border-slate-200 bg-white/85 px-7 py-4 font-black text-slate-700 shadow-sm backdrop-blur transition hover:-translate-y-1 hover:border-amber-300 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-900/80 dark:text-slate-200">
              Xem thành tích
            </a>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-2 text-sm font-bold text-slate-600 dark:text-slate-300">
            <span>Toán lớp 1–5</span>
            <span aria-hidden="true" class="text-slate-400">·</span>
            <span>Lời giải chi tiết từng bước</span>
            <span aria-hidden="true" class="text-slate-400">·</span>
            <span>Miễn phí & Không cần đăng nhập</span>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-xl">
          <div class="poster-character-stage" aria-hidden="true">
            <span class="poster-orb poster-orb-one"></span><span class="poster-orb poster-orb-two"></span>
            <img src="/models/mascots/squirrel-bear-poster.webp" alt="" width="1050" height="700" fetchpriority="high" class="poster-character-image" />
          </div>
          <div class="poster-grade-panel relative overflow-hidden rounded-[2rem] border border-emerald-200/90 bg-white/95 p-5 shadow-[0_28px_90px_rgba(15,23,42,0.13)] backdrop-blur-xl dark:border-slate-700 dark:bg-slate-900/92 md:p-7">
            <div class="flex items-center justify-between gap-5">
              <div>
                <p class="text-sm font-extrabold uppercase tracking-[0.14em] text-emerald-700 dark:text-emerald-300">Chương trình luyện tập</p>
                <h2 class="mt-2 text-2xl font-black text-slate-950 dark:text-white md:text-3xl">Chọn lớp đang học</h2>
              </div>
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-amber-100 to-orange-100 text-3xl shadow-inner dark:from-amber-400/15 dark:to-orange-400/10">🎓</span>
            </div>
            <div class="mt-6 grid gap-2.5">
              {grades.map((item) => (
                <a href={`/lop-${item.grade}`} class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-slate-50/70 p-3 transition hover:-translate-y-0.5 hover:border-violet-300 hover:bg-white hover:shadow-lg dark:border-slate-700 dark:bg-slate-800/70 dark:hover:border-violet-400 dark:hover:bg-slate-800" aria-label={`Mở ${item.title}`}>
                  <span class={`grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gradient-to-br text-lg font-black text-white shadow-md ${item.gradient}`}>{item.grade}</span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-black text-slate-900 dark:text-white group-hover:text-violet-700 dark:group-hover:text-violet-300 transition-colors">{item.title}</span>
                    <span class="mt-0.5 block truncate text-sm font-semibold text-slate-500 dark:text-slate-400">{item.short}</span>
                  </span>
                  <img src={`/models/grade-mascots/${item.grade}-compact.webp`} alt="" aria-hidden="true" width="56" height="56" class="h-14 w-14 shrink-0 object-contain drop-shadow-md transition group-hover:scale-110" />
                  <span class="text-lg text-slate-300 transition group-hover:translate-x-1.5 group-hover:text-violet-600 dark:text-slate-600 dark:group-hover:text-violet-300" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </div>
          <div class="absolute -bottom-4 -right-4 -z-10 h-full w-full rounded-[2rem] bg-gradient-to-br from-violet-200/80 to-sky-200/70 dark:from-violet-500/10 dark:to-sky-500/10"></div>
        </div>
      </div>
    </section>

    <!-- Thanh tiếp tục học -->
    <ContinueLearning client:load />

    <!-- Danh sách các khối lớp -->
    <section id="chon-lop" class="bg-white py-16 dark:bg-slate-950 md:py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-black uppercase tracking-[0.16em] text-violet-700 dark:text-violet-300">Hành trình Toán lớp 1–5</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 dark:text-white md:text-5xl">Mỗi lớp một chặng khám phá</h2>
          <p class="mt-4 max-w-2xl font-medium leading-7 text-slate-600 dark:text-slate-400">Từ những con số đầu tiên đến phân số, phần trăm và chuyển động, bé luôn có một người bạn đồng hành trong từng chủ đề.</p>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
          {grades.map((item) => (
            <a href={`/lop-${item.grade}`} class={`poster-grade-card group relative flex min-h-80 flex-col overflow-hidden rounded-[1.75rem] border bg-gradient-to-br p-5 transition duration-200 hover:-translate-y-1.5 hover:shadow-xl dark:bg-none dark:bg-slate-900 ${item.pale} ${item.border}`}>
              <img src={`/models/grade-mascots/${item.grade}-compact.webp`} alt="" aria-hidden="true" width="224" height="224" loading="lazy" class="poster-grade-ghost" />
              <div class="flex items-start justify-between gap-4">
                <span class={`grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br text-2xl font-black text-white shadow-lg ${item.gradient}`}>{item.grade}</span>
              </div>
              <h3 class="mt-6 text-xl font-black text-slate-950 dark:text-white">{item.title}</h3>
              <p class="mt-3 flex-1 text-sm font-medium leading-6 text-slate-600 dark:text-slate-400">{item.description}</p>
              <div class="mt-5 flex items-center justify-between border-t border-slate-200/80 pt-4 dark:border-slate-700">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400">{item.count} chủ đề</span>
                <span class={`font-black transition group-hover:translate-x-1.5 ${item.text}`}>Xem lộ trình →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Khối bắt đầu nhanh -->
    <section id="hoc-ngay" class="border-y border-slate-200 bg-slate-50 py-16 dark:border-slate-800 dark:bg-slate-900/60 md:py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <div>
            <p class="text-sm font-black uppercase tracking-[0.16em] text-sky-700 dark:text-sky-300">Bắt đầu nhanh</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 dark:text-white md:text-5xl">Một chủ đề cho mỗi khối lớp</h2>
          </div>
          <p class="max-w-lg font-medium leading-7 text-slate-600 dark:text-slate-400">Các bài tập quen thuộc giúp bé dễ dàng làm quen với cách luyện tập trên Trạng Toán.</p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {quickLessons.map((item) => (
            <a href={`/luyen-tap/lop-${item.grade}/${item.slug}`} class="group flex min-h-52 flex-col rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-violet-200 hover:shadow-xl dark:border-slate-700 dark:bg-slate-900 dark:hover:border-violet-400">
              <div class="flex items-center justify-between gap-3">
                <span class={`grid h-12 w-12 place-items-center rounded-xl bg-gradient-to-br text-xl text-white shadow-md ${item.color}`}>{item.icon}</span>
                <span class={`rounded-full px-2.5 py-1 text-xs font-black ${item.gradeColor}`}>Lớp {item.grade}</span>
              </div>
              <h3 class="mt-5 flex-1 font-black leading-snug text-slate-900 transition group-hover:text-violet-700 dark:text-white dark:group-hover:text-violet-300">{item.title}</h3>
              <span class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-sm font-black text-slate-500 dark:border-slate-800 dark:text-slate-400">
                Luyện ngay <span class="text-lg transition group-hover:translate-x-1.5 group-hover:text-violet-600">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Định hướng học tập -->
    <section class="bg-white py-16 dark:bg-slate-950 md:py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
          <div class="lg:sticky lg:top-28">
            <p class="text-sm font-black uppercase tracking-[0.16em] text-emerald-700 dark:text-emerald-300">Học hiệu quả hơn</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 dark:text-white md:text-5xl">Tập trung vào việc hiểu bài</h2>
            <p class="mt-5 font-medium leading-8 text-slate-600 dark:text-slate-400">Trạng Toán được thiết kế như một người bạn đồng hành: ngắn gọn, có chỉ dẫn rõ ràng và không tạo áp lực điểm số.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {strengths.map((item, index) => (
              <article class="rounded-[1.5rem] border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-900">
                <div class="flex items-center justify-between">
                  <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-2xl shadow-sm dark:bg-slate-800">{item.icon}</span>
                  <span class="text-sm font-black text-slate-300 dark:text-slate-700">0{index + 1}</span>
                </div>
                <h3 class="mt-5 text-lg font-black text-slate-900 dark:text-white">{item.title}</h3>
                <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-400">{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Khu vui chơi & Minigame đổi thưởng -->
    <section class="border-t border-slate-200 bg-gradient-to-b from-slate-50 to-violet-50/40 py-16 dark:border-slate-800 dark:from-slate-900/60 dark:to-slate-950 md:py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-violet-100/70 px-3.5 py-1.5 text-xs font-black text-violet-800 dark:border-violet-800 dark:bg-violet-900/40 dark:text-violet-300">
              <span>🎟️</span>
              <span>Đảo Minigame Thưởng Vé</span>
            </div>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 dark:text-white md:text-5xl">
              Luyện bài đạt điểm, nhận vé vui chơi
            </h2>
          </div>
          <p class="max-w-md font-medium leading-7 text-slate-600 dark:text-slate-300">
            Học toán hào hứng hơn với phần thưởng vé minigame sau mỗi bài tập đạt kết quả tốt. Hỗ trợ mượt mà trên TV, điện thoại, máy tính bảng và máy tính!
          </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="group flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:-translate-y-1.5 hover:border-cyan-300 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
            <div>
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-cyan-400 to-blue-600 text-3xl shadow-md">🚀</span>
              <h3 class="mt-4 text-lg font-black text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">Phi thuyền không gian</h3>
              <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Lái tàu vũ trụ lượn qua dải ngân hà, phá thiên thạch và thu thập sao lấp lánh.</p>
            </div>
            <div class="mt-4 flex flex-wrap gap-1 border-t border-slate-100 pt-3 dark:border-slate-800">
              <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[11px] font-bold text-slate-600 dark:text-slate-300">🎮 TV Remote</span>
              <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[11px] font-bold text-slate-600 dark:text-slate-300">📱 Cảm ứng</span>
            </div>
          </div>

          <div class="group flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:-translate-y-1.5 hover:border-violet-300 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
            <div>
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-violet-500 to-indigo-600 text-3xl shadow-md">🎈</span>
              <h3 class="mt-4 text-lg font-black text-slate-900 dark:text-white group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors">Bong bóng số học</h3>
              <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Bắn vỡ bong bóng số chẵn, lẻ hoặc phép tính. Thử thách phản xạ cực vui cho bé.</p>
            </div>
            <div class="mt-4 flex flex-wrap gap-1 border-t border-slate-100 pt-3 dark:border-slate-800">
              <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[11px] font-bold text-slate-600 dark:text-slate-300">🎮 Phím số TV</span>
              <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[11px] font-bold text-slate-600 dark:text-slate-300">🖱️ Chuột/Chạm</span>
            </div>
          </div>

          <div class="group flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:-translate-y-1.5 hover:border-emerald-300 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
            <div>
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 text-3xl shadow-md">🧱</span>
              <h3 class="mt-4 text-lg font-black text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Bóng nảy phá gạch</h3>
