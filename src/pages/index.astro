---
import '../styles/global.css';

const missions = [
  {
    icon: '🔢',
    title: 'Khám phá các con số',
    description: 'Đếm số, so sánh và làm quen với thế giới số học.',
    color: 'from-blue-400 to-cyan-400',
  },
  {
    icon: '➕',
    title: 'Phép tính vui nhộn',
    description: 'Học cộng, trừ qua hình ảnh và trò chơi tương tác.',
    color: 'from-violet-400 to-purple-500',
  },
  {
    icon: '🧩',
    title: 'Thử thách tư duy',
    description: 'Tìm quy luật, giải đố và rèn khả năng suy luận.',
    color: 'from-orange-400 to-amber-400',
  },
];

const lessons = [
  {
    number: 1,
    title: 'Đếm từ 1 đến 10',
    description: 'Cùng Dino đếm những đồ vật đáng yêu.',
    stars: 3,
    unlocked: true,
  },
  {
    number: 2,
    title: 'So sánh các số',
    description: 'Số nào lớn hơn, số nào nhỏ hơn?',
    stars: 0,
    unlocked: true,
  },
  {
    number: 3,
    title: 'Phép cộng đầu tiên',
    description: 'Gộp các nhóm đồ vật lại với nhau.',
    stars: 0,
    unlocked: false,
  },
];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Đảo Toán Học giúp trẻ tiểu học học Toán qua trò chơi, hình ảnh và những cuộc phiêu lưu vui nhộn."
    />
    <title>Đảo Toán Học – Học Toán thật vui</title>
  </head>

  <body class="min-h-screen bg-[#f7fbff] text-slate-800">
    <header
      class="sticky top-0 z-50 border-b border-sky-100 bg-white/90 backdrop-blur"
    >
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 md:px-8"
      >
        <a href="/" class="flex items-center gap-3">
          <span
            class="grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-500 text-2xl shadow-lg shadow-emerald-200"
          >
            🦕
          </span>

          <div>
            <p class="text-lg font-black text-slate-900">Đảo Toán Học</p>
            <p class="text-xs font-semibold text-slate-500">
              Học vui mỗi ngày
            </p>
          </div>
        </a>

        <nav class="hidden items-center gap-2 md:flex">
          <a
            href="#hanh-trinh"
            class="rounded-xl px-4 py-2 font-bold text-slate-600 transition hover:bg-sky-50 hover:text-sky-600"
          >
            Hành trình
          </a>

          <a
            href="#nhiem-vu"
            class="rounded-xl px-4 py-2 font-bold text-slate-600 transition hover:bg-sky-50 hover:text-sky-600"
          >
            Nhiệm vụ
          </a>

          <a
            href="#phu-huynh"
            class="rounded-xl px-4 py-2 font-bold text-slate-600 transition hover:bg-sky-50 hover:text-sky-600"
          >
            Góc phụ huynh
          </a>
        </nav>

        <button
          class="rounded-2xl bg-violet-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-violet-200 transition hover:-translate-y-0.5 hover:bg-violet-700"
        >
          Bắt đầu học
        </button>
      </div>
    </header>

    <main>
      <section class="relative overflow-hidden">
        <div
          class="absolute -left-20 top-20 h-64 w-64 rounded-full bg-cyan-200/40 blur-3xl"
        >
        </div>

        <div
          class="absolute -right-20 top-0 h-80 w-80 rounded-full bg-violet-200/40 blur-3xl"
        >
        </div>

        <div
          class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 md:px-8 lg:grid-cols-2 lg:py-24"
        >
          <div>
            <div
              class="mb-5 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-black text-amber-700"
            >
              <span>⭐</span>
              Toán tiểu học qua trò chơi
            </div>

            <h1
              class="max-w-2xl text-4xl font-black leading-tight text-slate-900 md:text-6xl"
            >
              Mỗi bài Toán là một
              <span
                class="bg-gradient-to-r from-violet-600 to-sky-500 bg-clip-text text-transparent"
              >
                chuyến phiêu lưu
              </span>
            </h1>

            <p
              class="mt-6 max-w-xl text-lg font-medium leading-8 text-slate-600"
            >
              Cùng Dino khám phá những hòn đảo kỳ thú, giải câu đố, thu
              thập sao vàng và luyện Toán thật vui mỗi ngày.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href="#hanh-trinh"
                class="rounded-2xl bg-gradient-to-r from-violet-600 to-indigo-600 px-7 py-4 text-center font-black text-white shadow-xl shadow-violet-200 transition hover:-translate-y-1"
              >
                Bắt đầu hành trình 🚀
              </a>

              <a
                href="#phu-huynh"
                class="rounded-2xl border-2 border-slate-200 bg-white px-7 py-4 text-center font-black text-slate-700 transition hover:border-sky-300 hover:bg-sky-50"
              >
                Dành cho phụ huynh
              </a>
            </div>

            <div class="mt-8 flex flex-wrap gap-5 text-sm font-bold text-slate-500">
              <span>✓ Bài học ngắn 5–10 phút</span>
              <span>✓ Phù hợp trẻ lớp 1–2</span>
              <span>✓ Học thử miễn phí</span>
            </div>
          </div>

          <div class="relative mx-auto w-full max-w-lg">
            <div
              class="rotate-2 rounded-[2.5rem] border-4 border-white bg-gradient-to-br from-sky-300 via-cyan-200 to-emerald-200 p-6 shadow-2xl shadow-sky-200/70"
            >
              <div
                class="rounded-[2rem] bg-white/90 p-7 text-center backdrop-blur"
              >
                <div class="text-8xl">🦕</div>

                <p class="mt-4 text-sm font-black uppercase tracking-widest text-violet-600">
                  Nhiệm vụ hôm nay
                </p>

                <h2 class="mt-2 text-2xl font-black text-slate-900">
                  Giúp Dino tìm 8 quả táo
                </h2>

                <div class="my-6 flex flex-wrap justify-center gap-3 text-4xl">
                  <span>🍎</span>
                  <span>🍎</span>
                  <span>🍎</span>
                  <span>🍎</span>
                  <span>🍎</span>
                  <span>🍎</span>
                  <span>🍎</span>
                  <span>🍎</span>
                </div>

                <div class="rounded-2xl bg-slate-100 p-4">
                  <div class="mb-2 flex justify-between text-sm font-black">
                    <span>Tiến độ</span>
                    <span class="text-emerald-600">2/3 bài</span>
                  </div>

                  <div class="h-3 overflow-hidden rounded-full bg-white">
                    <div
                      class="h-full w-2/3 rounded-full bg-gradient-to-r from-emerald-400 to-teal-400"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div
              class="absolute -left-5 top-10 -rotate-12 rounded-2xl bg-white p-3 text-3xl shadow-lg"
            >
              ✏️
            </div>

            <div
              class="absolute -right-4 bottom-14 rotate-12 rounded-2xl bg-white p-3 text-3xl shadow-lg"
            >
              🏆
            </div>
          </div>
        </div>
      </section>

      <section id="nhiem-vu" class="mx-auto max-w-7xl px-4 py-16 md:px-8">
        <div class="text-center">
          <p class="font-black uppercase tracking-widest text-violet-600">
            Học từng bước nhỏ
          </p>

          <h2 class="mt-3 text-3xl font-black text-slate-900 md:text-4xl">
            Hôm nay bé muốn khám phá gì?
          </h2>

          <p class="mx-auto mt-4 max-w-2xl font-medium text-slate-600">
            Mỗi hoạt động được thiết kế ngắn gọn, trực quan và vừa sức với
            trẻ tiểu học.
          </p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {
            missions.map((mission) => (
              <article
                class="group rounded-3xl border border-slate-100 bg-white p-6 shadow-lg shadow-slate-200/50 transition hover:-translate-y-2 hover:shadow-xl"
              >
                <div
                  class={`grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br text-3xl shadow-lg ${mission.color}`}
                >
                  {mission.icon}
                </div>

                <h3 class="mt-5 text-xl font-black text-slate-900">
                  {mission.title}
                </h3>

                <p class="mt-3 font-medium leading-7 text-slate-600">
                  {mission.description}
                </p>

                <button
                  class="mt-5 font-black text-violet-600 transition group-hover:translate-x-1"
                >
                  Khám phá ngay →
                </button>
              </article>
            ))
          }
        </div>
      </section>

      <section id="hanh-trinh" class="bg-gradient-to-b from-sky-50 to-white py-16">
        <div class="mx-auto max-w-5xl px-4 md:px-8">
          <div class="text-center">
            <p class="font-black uppercase tracking-widest text-sky-600">
              Hành trình của bé
            </p>

            <h2 class="mt-3 text-3xl font-black text-slate-900 md:text-4xl">
              Những bài học đầu tiên
            </h2>
          </div>

          <div class="mt-10 space-y-5">
            {
              lessons.map((lesson) => (
                <article
                  class:list={[
                    'flex items-center gap-5 rounded-3xl border bg-white p-5 shadow-md transition',
                    lesson.unlocked
                      ? 'border-sky-100 hover:-translate-y-1 hover:shadow-lg'
                      : 'border-slate-100 opacity-60',
                  ]}
                >
                  <div
                    class:list={[
                      'grid h-16 w-16 shrink-0 place-items-center rounded-2xl text-xl font-black text-white',
                      lesson.unlocked
                        ? 'bg-gradient-to-br from-sky-400 to-blue-500'
                        : 'bg-slate-300',
                    ]}
                  >
                    {lesson.unlocked ? lesson.number : '🔒'}
                  </div>

                  <div class="min-w-0 flex-1">
                    <h3 class="text-lg font-black text-slate-900">
                      {lesson.title}
                    </h3>

                    <p class="mt-1 font-medium text-slate-500">
                      {lesson.description}
                    </p>

                    <div class="mt-2 text-lg">
                      {[1, 2, 3].map((star) => (
                        <span class={star <= lesson.stars ? '' : 'grayscale opacity-25'}>
                          ⭐
                        </span>
                      ))}
                    </div>
                  </div>

                  <button
                    disabled={!lesson.unlocked}
                    class:list={[
                      'hidden rounded-2xl px-5 py-3 font-black sm:block',
                      lesson.unlocked
                        ? 'bg-emerald-500 text-white hover:bg-emerald-600'
                        : 'cursor-not-allowed bg-slate-200 text-slate-400',
                    ]}
                  >
                    {lesson.stars > 0 ? 'Học lại' : 'Bắt đầu'}
                  </button>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="phu-huynh" class="mx-auto max-w-7xl px-4 py-16 md:px-8">
        <div
          class="overflow-hidden rounded-[2.5rem] bg-gradient-to-r from-violet-600 to-indigo-600 p-8 text-white shadow-2xl shadow-violet-200 md:p-12"
        >
          <div class="grid items-center gap-8 md:grid-cols-[1fr_auto]">
            <div>
              <p class="font-black uppercase tracking-widest text-violet-200">
                Dành cho bố mẹ
              </p>

              <h2 class="mt-3 text-3xl font-black md:text-4xl">
                Đồng hành cùng quá trình học của con
              </h2>

              <p class="mt-4 max-w-2xl text-lg leading-8 text-violet-100">
                Theo dõi thời gian học, kết quả từng kỹ năng và nhận gợi ý
                bài luyện phù hợp cho bé.
              </p>
            </div>

            <button
              class="rounded-2xl bg-white px-7 py-4 font-black text-violet-700 shadow-lg transition hover:-translate-y-1"
            >
              Xem góc phụ huynh
            </button>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-slate-200 bg-white">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-8 text-sm font-semibold text-slate-500 md:flex-row md:items-center md:justify-between md:px-8"
      >
        <p>© 2026 Đảo Toán Học</p>
        <p>Học đúng cách, tiến bộ mỗi ngày.</p>
      </div>
    </footer>
  </body>
</html>