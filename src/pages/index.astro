---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContinueLearning from '../components/ContinueLearning';
import { grade1PracticeModules } from '../data/grade1Curriculum';
import { grade2PracticeModules } from '../data/grade2Curriculum';
import { grade3PracticeModules } from '../data/grade3Curriculum';
import { grade4PracticeModules } from '../data/grade4Curriculum';
import { grade5PracticeModules } from '../data/grade5Curriculum';

const grade1ReadyModules = grade1PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade2ReadyModules = grade2PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade3ReadyModules = grade3PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade4ReadyModules = grade4PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade5ReadyModules = grade5PracticeModules;

const readyCurricula = [
  { grade: 1, modules: grade1ReadyModules },
  { grade: 2, modules: grade2ReadyModules },
  { grade: 3, modules: grade3ReadyModules },
  { grade: 4, modules: grade4ReadyModules },
  { grade: 5, modules: grade5ReadyModules },
];

const totalReadyModules = readyCurricula.reduce((total, curriculum) => total + curriculum.modules.length, 0);
const readyGrades = readyCurricula.filter((curriculum) => curriculum.modules.length > 0).map((curriculum) => curriculum.grade);
const readyGradeRange = readyGrades.length === 1
  ? `lớp ${readyGrades[0]}`
  : `lớp ${readyGrades[0]}–${readyGrades.at(-1)}`;

const grades = [
  { grade: 1, mascot: '🐿️', title: 'Toán lớp 1', description: 'Số đến 100, cộng trừ, hình học, độ dài và thời gian.', count: grade1ReadyModules.length, status: 'Đã có bài luyện', gradient: 'from-violet-500 to-indigo-600', pale: 'from-violet-50 to-indigo-50', border: 'border-violet-200', text: 'text-violet-700' },
  { grade: 2, mascot: '🐻', title: 'Toán lớp 2', description: 'Cộng trừ có nhớ, nhân chia, số đến 1 000 và dữ liệu.', count: grade2ReadyModules.length, status: 'Đã có bài luyện', gradient: 'from-cyan-400 to-blue-600', pale: 'from-cyan-50 to-blue-50', border: 'border-cyan-200', text: 'text-sky-700' },
  { grade: 3, mascot: '🐿️', title: 'Toán lớp 3', description: 'Nhân chia, số đến 100 000, hình học và đo lường.', count: grade3ReadyModules.length, status: 'Đã có bài luyện', gradient: 'from-emerald-400 to-teal-600', pale: 'from-emerald-50 to-teal-50', border: 'border-emerald-200', text: 'text-emerald-700' },
  { grade: 4, mascot: '🐻', title: 'Toán lớp 4', description: 'Số lớn, phân số, trung bình cộng và hình học.', count: grade4ReadyModules.length, status: 'Đã có đủ bài luyện', gradient: 'from-orange-400 to-amber-600', pale: 'from-orange-50 to-amber-50', border: 'border-orange-200', text: 'text-orange-700' },
  { grade: 5, mascot: '🦊', title: 'Toán lớp 5', description: 'Số thập phân, tỉ số, phần trăm, diện tích và thể tích.', count: grade5ReadyModules.length, status: 'Đã có đủ bài luyện', gradient: 'from-pink-400 to-rose-600', pale: 'from-pink-50 to-rose-50', border: 'border-rose-200', text: 'text-rose-700' },
];

const quickLessons = [
  ...grade1ReadyModules.slice(0, 2).map((item) => ({ ...item, grade: 1, gradeColor: 'bg-violet-100 text-violet-700' })),
  ...grade2ReadyModules.slice(0, 2).map((item) => ({ ...item, grade: 2, gradeColor: 'bg-sky-100 text-sky-700' })),
  ...grade3ReadyModules.slice(0, 2).map((item) => ({ ...item, grade: 3, gradeColor: 'bg-emerald-100 text-emerald-700' })),
  ...grade4ReadyModules.slice(0, 2).map((item) => ({ ...item, grade: 4, gradeColor: 'bg-orange-100 text-orange-700' })),
  ...grade5ReadyModules.slice(0, 2).map((item) => ({ ...item, grade: 5, gradeColor: 'bg-pink-100 text-pink-700' })),
];
---

<BaseLayout title="Trạng Toán – Luyện Toán tiểu học lớp 1–5" description="Website luyện tập Toán lớp 1 đến lớp 5 với câu hỏi trực quan, sinh động và bám sát nội dung học trên lớp.">
  <SiteHeader />
  <main class="overflow-hidden">
    <section class="relative bg-gradient-to-br from-[#fbfcfe] via-white to-violet-50">
      <div class="absolute -left-32 top-20 h-80 w-80 rounded-full bg-amber-100/60 blur-3xl dark:bg-amber-400/5"></div><div class="absolute -right-24 top-0 h-96 w-96 rounded-full bg-violet-100/70 blur-3xl dark:bg-violet-500/10"></div><div class="absolute inset-0 opacity-20 [background-image:radial-gradient(#94a3b8_1px,transparent_1px)] [background-size:28px_28px] dark:opacity-10"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-14 md:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:py-20">
        <div><div class="inline-flex items-center gap-2 rounded-full border border-amber-200/80 bg-white/80 px-4 py-2 text-sm font-black text-amber-800 shadow-sm backdrop-blur dark:border-amber-400/20 dark:bg-amber-400/10 dark:text-amber-300">⭐ Luyện Toán tiểu học lớp 1–5</div><h1 class="mt-6 text-5xl font-black leading-[1.06] tracking-[-0.045em] text-slate-950 md:text-6xl">Học Toán vui hơn, <span class="bg-gradient-to-r from-violet-600 via-fuchsia-500 to-orange-500 bg-clip-text text-transparent">tiến bộ mỗi ngày</span></h1><p class="mt-6 max-w-2xl text-lg font-medium leading-8 text-slate-600">Chọn đúng lớp, mở đúng bài đang học và bắt đầu luyện ngay. Mỗi lượt ngắn gọn, trực quan và có phản hồi tức thì.</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><a href="#chon-lop" class="flex items-center justify-center gap-3 rounded-xl bg-violet-600 px-7 py-4 font-black text-white shadow-lg shadow-violet-200/70 transition hover:-translate-y-1 hover:bg-violet-700">🎒 Chọn lớp của bé <span>→</span></a><a href="#hoc-ngay" class="flex items-center justify-center gap-3 rounded-xl border border-slate-200 bg-white px-7 py-4 font-black text-slate-700 shadow-sm transition hover:-translate-y-1 hover:border-violet-300 hover:text-violet-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">⚡ Chọn bài học ngay</a></div><div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm font-bold text-slate-500"><span>✓ Không cần đăng nhập</span><span>✓ Không khóa bài</span><span>✓ Dùng tốt trên mọi màn hình</span></div></div>
        <div class="relative mx-auto w-full max-w-xl"><div class="relative rounded-[2rem] border border-slate-200/80 bg-white/90 p-6 text-slate-900 shadow-[0_24px_80px_rgba(15,23,42,0.12)] backdrop-blur dark:border-slate-700 dark:bg-slate-900/90 dark:text-white md:p-8"><div class="flex items-start justify-between"><div><p class="font-black text-violet-700 dark:text-violet-300">Hôm nay bé muốn học gì?</p><h2 class="mt-2 text-3xl font-black">Chọn lớp và bắt đầu</h2></div><div class="flex -space-x-3"><span class="grid h-14 w-14 place-items-center rounded-2xl border-4 border-white bg-amber-100 text-3xl dark:border-slate-900">🐿️</span><span class="grid h-14 w-14 place-items-center rounded-2xl border-4 border-white bg-orange-100 text-3xl dark:border-slate-900">🐻</span></div></div><div class="mt-7 grid grid-cols-5 gap-2">{grades.map((item) => <a href={`/lop-${item.grade}`} class={`group grid aspect-square place-items-center rounded-xl bg-gradient-to-br text-xl font-black text-white shadow-md transition hover:-translate-y-1 hover:scale-105 ${item.gradient}`} aria-label={`Mở ${item.title}`}>{item.grade}</a>)}</div><div class="mt-6 rounded-xl bg-slate-50 p-4 dark:bg-slate-800"><div class="flex items-center justify-between gap-3"><div><p class="text-sm font-bold text-slate-500 dark:text-slate-400">Đang có thể luyện</p><p class="mt-1 text-2xl font-black">{totalReadyModules} chủ đề {readyGradeRange}</p></div><span class="text-4xl">🏆</span></div></div></div><div class="absolute -bottom-4 -right-4 -z-10 h-full w-full rounded-[2rem] bg-violet-200/70 dark:bg-violet-500/15"></div></div>
      </div>
    </section>

    <ContinueLearning client:load />

    <section id="chon-lop" class="bg-white py-16 md:py-20"><div class="mx-auto max-w-7xl px-4 md:px-8"><div class="text-center"><p class="font-black tracking-[0.14em] text-violet-700">Chọn lớp phù hợp</p><h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 md:text-5xl">Mỗi lớp một hành trình riêng</h2><p class="mx-auto mt-4 max-w-2xl font-medium leading-7 text-slate-600">Toàn bộ lớp 1–5 đã có bài luyện theo từng chủ đề, giúp bé chọn đúng nội dung đang học trên lớp.</p></div><div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-6">{grades.map((item, index) => <a href={`/lop-${item.grade}`} class={`group relative overflow-hidden rounded-[2rem] border-2 bg-gradient-to-br p-6 shadow-sm transition hover:-translate-y-2 hover:shadow-xl ${item.pale} ${item.border} ${index < 3 ? 'lg:col-span-2' : 'lg:col-span-3'}`}><div class="flex items-start justify-between gap-4"><span class={`grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br text-3xl font-black text-white shadow-lg ${item.gradient}`}>{item.grade}</span><span class="text-4xl transition group-hover:rotate-6 group-hover:scale-110">{item.mascot}</span></div><p class={`mt-6 text-xs font-black ${item.text}`}>{item.status}</p><h3 class="mt-1 text-2xl font-black text-slate-950">{item.title}</h3><p class="mt-3 font-medium leading-7 text-slate-600">{item.description}</p><div class="mt-6 flex items-center justify-between border-t border-slate-200/70 pt-4"><span class="text-sm font-bold text-slate-500">{item.count ? `${item.count} mục luyện tập` : 'Khung chương trình'}</span><span class={`font-black transition group-hover:translate-x-1 ${item.text}`}>Mở lớp →</span></div></a>)}</div></div></section>

    <section id="hoc-ngay" class="border-y border-slate-200 bg-slate-50 py-16 md:py-20"><div class="mx-auto max-w-7xl px-4 md:px-8"><div class="flex flex-col justify-between gap-4 md:flex-row md:items-end"><div><p class="font-black tracking-[0.14em] text-sky-700">Học ngay</p><h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 md:text-5xl">Bài học được chọn nhiều</h2></div><p class="max-w-xl font-medium leading-7 text-slate-600">Bấm vào bất kỳ vị trí nào trên thẻ để mở bài. Không cần tìm đúng nút nhỏ.</p></div><div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">{quickLessons.map((item) => <a href={`/luyen-tap/lop-${item.grade}/${item.slug}`} class="group flex items-center gap-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-violet-200 hover:shadow-xl"><span class={`grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br text-2xl text-white ${item.color}`}>{item.icon}</span><span class="min-w-0 flex-1"><span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-black ${item.gradeColor}`}>Lớp {item.grade}</span><span class="mt-2 block font-black leading-snug text-slate-900 group-hover:text-violet-700">{item.title}</span></span><span class="text-xl text-slate-400 transition group-hover:translate-x-1 group-hover:text-violet-600">→</span></a>)}</div><div class="mt-8 flex flex-wrap justify-center gap-3"><a href="/lop-1" class="rounded-2xl bg-violet-600 px-6 py-3 font-black text-white">Xem toàn bộ lớp 1</a><a href="/lop-2" class="rounded-2xl bg-sky-600 px-6 py-3 font-black text-white">Xem toàn bộ lớp 2</a><a href="/lop-3" class="rounded-2xl bg-emerald-600 px-6 py-3 font-black text-white">Xem toàn bộ lớp 3</a><a href="/lop-4" class="rounded-2xl bg-orange-600 px-6 py-3 font-black text-white">Xem lớp 4</a><a href="/lop-5" class="rounded-2xl bg-pink-600 px-6 py-3 font-black text-white">Xem lớp 5</a></div></div></section>

    <section class="border-y border-slate-200 bg-slate-100 py-16 dark:border-slate-800 dark:bg-slate-950"><div class="mx-auto max-w-7xl px-4 md:px-8"><div class="text-center"><p class="font-black tracking-[0.14em] text-violet-700 dark:text-violet-300">Cách học đơn giản</p><h2 class="mt-3 text-3xl font-black text-slate-950 dark:text-white md:text-5xl">Bé có thể tự bắt đầu</h2></div><div class="mt-10 grid gap-5 md:grid-cols-3">{[['🎯','Chọn bài đang học','Vào đúng lớp và chủ đề cần luyện thêm.'],['🧠','Trả lời câu hỏi','Quan sát hình, chọn đáp án và nhận phản hồi ngay.'],['🏆','Xem kết quả','Biết số câu đúng và kỹ năng cần luyện lại.']].map(([icon,title,description], index) => <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm dark:border-slate-800 dark:bg-slate-900"><div class="flex items-center justify-between"><span class="text-4xl">{icon}</span><span class="text-4xl font-black text-slate-200 dark:text-slate-700">0{index + 1}</span></div><h3 class="mt-6 text-xl font-black text-slate-900 dark:text-white">{title}</h3><p class="mt-3 font-medium leading-7 text-slate-500 dark:text-slate-400">{description}</p></article>)}</div></div></section>

    <section id="phu-huynh" class="bg-white py-16 md:py-20"><div class="mx-auto max-w-7xl px-4 md:px-8"><div class="grid items-center gap-8 overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-violet-600 via-purple-600 to-blue-600 p-8 text-white shadow-2xl shadow-violet-200 md:grid-cols-[1fr_auto] md:p-12"><div><div class="text-4xl">🐿️ 🐻</div><h2 class="mt-5 text-3xl font-black tracking-tight md:text-5xl">Luyện thêm đúng lúc, không tạo áp lực</h2><p class="mt-5 max-w-3xl text-lg font-medium leading-8 text-violet-100">Trạng Toán bổ trợ quá trình học trên lớp. Giáo viên và sách giáo khoa vẫn là nền tảng chính; website giúp trẻ luyện lại bằng câu hỏi ngắn và sinh động.</p></div><a href="#chon-lop" class="rounded-2xl bg-white px-7 py-4 text-center font-black text-violet-700 shadow-xl transition hover:-translate-y-1">Chọn lớp để bắt đầu</a></div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
