---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContinueLearning from '../components/ContinueLearning.astro';
import { grade1PracticeModules } from '../data/grade1Curriculum';
import { grade2PracticeModules } from '../data/grade2Curriculum';
import { grade3PracticeModules } from '../data/grade3Curriculum';
import { grade4PracticeModules } from '../data/grade4Curriculum';
import { grade5PracticeModules } from '../data/grade5Curriculum';

const grade1ReadyModules = grade1PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade2ReadyModules = grade2PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade3ReadyModules = grade3PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade4ReadyModules = grade4PracticeModules.filter((item) => item.developmentStatus === 'ready');
const grade5ReadyModules = grade5PracticeModules.filter((item) => item.developmentStatus === 'ready');

const grades = [
  {
    grade: 1,
    mascot: '🐰',
    title: 'Toán lớp 1',
    short: 'Số & phép tính đầu tiên',
    description: 'Số đến 100, cộng trừ trong phạm vi 10 và 100, hình học trực quan, độ dài và xem giờ.',
    count: grade1ReadyModules.length,
    gradient: 'from-violet-500 to-indigo-600',
    accentGradient: 'from-violet-500 via-purple-500 to-indigo-600',
    badgeGradient: 'from-violet-500 to-indigo-600',
    border: 'border-violet-200/90 dark:border-violet-900/50',
    hoverBorder: 'hover:border-violet-400 dark:hover:border-violet-500',
    hoverShadow: 'hover:shadow-[0_24px_48px_-12px_rgba(139,92,246,0.22)]',
    pillBg: 'border-violet-200 bg-violet-50/90 text-violet-700 dark:border-violet-800/80 dark:bg-violet-950/60 dark:text-violet-300',
    text: 'text-violet-600 dark:text-violet-400',
    lightTint: 'from-violet-50/50 via-white to-indigo-50/30'
  },
  {
    grade: 2,
    mascot: '🐱',
    title: 'Toán lớp 2',
    short: 'Tính toán & đo lường',
    description: 'Cộng trừ có nhớ trong phạm vi 100, làm quen phép nhân chia, số đến 1 000 và biểu đồ tranh.',
    count: grade2ReadyModules.length,
    gradient: 'from-sky-400 to-blue-600',
    accentGradient: 'from-sky-400 via-cyan-500 to-blue-600',
    badgeGradient: 'from-sky-400 to-blue-600',
    border: 'border-sky-200/90 dark:border-sky-900/50',
    hoverBorder: 'hover:border-sky-400 dark:hover:border-sky-500',
    hoverShadow: 'hover:shadow-[0_24px_48px_-12px_rgba(14,165,233,0.22)]',
    pillBg: 'border-sky-200 bg-sky-50/90 text-sky-700 dark:border-sky-800/80 dark:bg-sky-950/60 dark:text-sky-300',
    text: 'text-sky-600 dark:text-sky-400',
    lightTint: 'from-sky-50/50 via-white to-blue-50/30'
  },
  {
    grade: 3,
    mascot: '🐶',
    title: 'Toán lớp 3',
    short: 'Nhân chia & số lớn',
    description: 'Bảng nhân chia từ 2 đến 9, số trong phạm vi 100 000, tính chu vi, diện tích và giải toán có lời văn.',
    count: grade3ReadyModules.length,
    gradient: 'from-emerald-400 to-teal-600',
    accentGradient: 'from-emerald-400 via-teal-500 to-cyan-600',
    badgeGradient: 'from-emerald-400 to-teal-600',
    border: 'border-emerald-200/90 dark:border-emerald-900/50',
    hoverBorder: 'hover:border-emerald-400 dark:hover:border-emerald-500',
    hoverShadow: 'hover:shadow-[0_24px_48px_-12px_rgba(16,185,129,0.22)]',
    pillBg: 'border-emerald-200 bg-emerald-50/90 text-emerald-700 dark:border-emerald-800/80 dark:bg-emerald-950/60 dark:text-emerald-300',
    text: 'text-emerald-600 dark:text-emerald-400',
    lightTint: 'from-emerald-50/50 via-white to-teal-50/30'
  },
  {
    grade: 4,
    mascot: '🐯',
    title: 'Toán lớp 4',
    short: 'Số lớn & phân số',
    description: 'Số có nhiều chữ số, phép tính phân số, trung bình cộng, tìm hai số khi biết tổng và hiệu.',
    count: grade4ReadyModules.length,
    gradient: 'from-amber-400 to-orange-600',
    accentGradient: 'from-amber-400 via-orange-500 to-rose-500',
    badgeGradient: 'from-amber-400 to-orange-600',
    border: 'border-amber-200/90 dark:border-amber-900/50',
    hoverBorder: 'hover:border-amber-400 dark:hover:border-amber-500',
    hoverShadow: 'hover:shadow-[0_24px_48px_-12px_rgba(249,115,22,0.22)]',
    pillBg: 'border-amber-200 bg-amber-50/90 text-amber-700 dark:border-amber-800/80 dark:bg-amber-950/60 dark:text-amber-300',
    text: 'text-amber-600 dark:text-amber-400',
    lightTint: 'from-amber-50/50 via-white to-orange-50/30'
  },
  {
    grade: 5,
    mascot: '🦁',
    title: 'Toán lớp 5',
    short: 'Thập phân & tỉ số',
    description: 'Số thập phân, tỉ số phần trăm, diện tích hình tam giác, hình tròn, thể tích và toán chuyển động đều.',
    count: grade5ReadyModules.length,
    gradient: 'from-rose-500 to-pink-600',
    accentGradient: 'from-rose-500 via-pink-500 to-purple-600',
    badgeGradient: 'from-rose-500 to-pink-600',
    border: 'border-rose-200/90 dark:border-rose-900/50',
    hoverBorder: 'hover:border-rose-400 dark:hover:border-rose-500',
    hoverShadow: 'hover:shadow-[0_24px_48px_-12px_rgba(244,63,94,0.22)]',
    pillBg: 'border-rose-200 bg-rose-50/90 text-rose-700 dark:border-rose-800/80 dark:bg-rose-950/60 dark:text-rose-300',
    text: 'text-rose-600 dark:text-rose-400',
    lightTint: 'from-rose-50/50 via-white to-pink-50/30'
  },
];

const quickLessons = [
  {
    ...grade1ReadyModules[0],
    grade: 1,
    accentGradient: 'from-violet-500 via-purple-500 to-indigo-600',
    border: 'border-violet-200/90 dark:border-violet-900/50',
    hoverBorder: 'hover:border-violet-400 dark:hover:border-violet-500',
    hoverShadow: 'hover:shadow-[0_20px_40px_-10px_rgba(139,92,246,0.18)]',
    gradeBadge: 'bg-violet-50 text-violet-700 border-violet-200/80 dark:bg-violet-950/60 dark:text-violet-300 dark:border-violet-800/60',
    iconGradient: 'from-violet-500 to-indigo-600',
    textAccent: 'text-violet-600 dark:text-violet-400',
    arrowBg: 'group-hover:bg-gradient-to-r group-hover:from-violet-500 group-hover:to-indigo-600'
  },
  {
    ...grade2ReadyModules[0],
    grade: 2,
    accentGradient: 'from-sky-400 via-cyan-500 to-blue-600',
    border: 'border-sky-200/90 dark:border-sky-900/50',
    hoverBorder: 'hover:border-sky-400 dark:hover:border-sky-500',
    hoverShadow: 'hover:shadow-[0_20px_40px_-10px_rgba(14,165,233,0.18)]',
    gradeBadge: 'bg-sky-50 text-sky-700 border-sky-200/80 dark:bg-sky-950/60 dark:text-sky-300 dark:border-sky-800/60',
    iconGradient: 'from-sky-400 to-blue-600',
    textAccent: 'text-sky-600 dark:text-sky-400',
    arrowBg: 'group-hover:bg-gradient-to-r group-hover:from-sky-400 group-hover:to-blue-600'
  },
  {
    ...grade3ReadyModules[0],
    grade: 3,
    accentGradient: 'from-emerald-400 via-teal-500 to-cyan-600',
    border: 'border-emerald-200/90 dark:border-emerald-900/50',
    hoverBorder: 'hover:border-emerald-400 dark:hover:border-emerald-500',
    hoverShadow: 'hover:shadow-[0_20px_40px_-10px_rgba(16,185,129,0.18)]',
    gradeBadge: 'bg-emerald-50 text-emerald-700 border-emerald-200/80 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800/60',
    iconGradient: 'from-emerald-400 to-teal-600',
    textAccent: 'text-emerald-600 dark:text-emerald-400',
    arrowBg: 'group-hover:bg-gradient-to-r group-hover:from-emerald-400 group-hover:to-teal-600'
  },
  {
    ...grade4ReadyModules[0],
    grade: 4,
    accentGradient: 'from-amber-400 via-orange-500 to-rose-500',
    border: 'border-amber-200/90 dark:border-amber-900/50',
    hoverBorder: 'hover:border-amber-400 dark:hover:border-amber-500',
    hoverShadow: 'hover:shadow-[0_20px_40px_-10px_rgba(249,115,22,0.18)]',
    gradeBadge: 'bg-amber-50 text-amber-700 border-amber-200/80 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800/60',
    iconGradient: 'from-amber-400 to-orange-600',
    textAccent: 'text-amber-600 dark:text-amber-400',
    arrowBg: 'group-hover:bg-gradient-to-r group-hover:from-amber-400 group-hover:to-orange-600'
  },
  {
    ...grade5ReadyModules[0],
    grade: 5,
    accentGradient: 'from-rose-500 via-pink-500 to-purple-600',
    border: 'border-rose-200/90 dark:border-rose-900/50',
    hoverBorder: 'hover:border-rose-400 dark:hover:border-rose-500',
    hoverShadow: 'hover:shadow-[0_20px_40px_-10px_rgba(244,63,94,0.18)]',
    gradeBadge: 'bg-rose-50 text-rose-700 border-rose-200/80 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800/60',
    iconGradient: 'from-rose-500 to-pink-600',
    textAccent: 'text-rose-600 dark:text-rose-400',
    arrowBg: 'group-hover:bg-gradient-to-r group-hover:from-rose-500 group-hover:to-pink-600'
  },
].filter((item) => item.slug);

const strengths = [
  { icon: '📘', title: 'Bám sát bài học trên lớp', description: 'Bài tập sắp xếp theo tuần và từng chủ đề quen thuộc, giúp bé củng cố ngay kiến thức vừa học.' },
  { icon: '🧠', title: 'Gợi ý khi gặp bài khó', description: 'Gợi ý mở dần từng nấc giúp bé tự suy nghĩ tìm ra cách làm, kèm lời giải từng bước rõ ràng.' },
  { icon: '🎯', title: 'Nhận biết điểm chưa vững', description: 'Ghi nhận dạng toán bé còn lúng túng để nhắc ôn lại đúng lúc, giúp bé tiến bộ từng ngày.' },
  { icon: '📱', title: 'Tiện học trên mọi thiết bị', description: 'Học mượt mà trên điện thoại, máy tính bảng, máy tính hoặc mở nhanh trên màn hình TV.' },
];
---

<BaseLayout title="Trạng Toán – Luyện Toán tiểu học lớp 1–5" description="Website luyện tập Toán lớp 1 đến lớp 5 với câu hỏi trực quan, gợi ý và lời giải từng bước.">
  <SiteHeader />
  <main class="overflow-hidden">
    <!-- Hero Section -->
    <section class="poster-hero relative overflow-hidden border-b border-slate-200/70 dark:border-slate-800">
      <div class="absolute inset-0 opacity-[0.14] [background-image:radial-gradient(#6366f1_1px,transparent_1px)] [background-size:28px_28px] dark:opacity-[0.06]"></div>
      <div class="absolute -left-36 top-24 h-96 w-96 rounded-full bg-indigo-300/30 blur-3xl dark:bg-indigo-600/10"></div>
      <div class="absolute -right-32 -top-24 h-[32rem] w-[32rem] rounded-full bg-sky-300/25 blur-3xl dark:bg-sky-600/10"></div>
      <div class="absolute left-1/2 bottom-0 h-64 w-64 -translate-x-1/2 rounded-full bg-emerald-200/20 blur-3xl dark:bg-emerald-600/5"></div>
      
      <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-12 sm:py-16 md:px-8 lg:grid-cols-[1.08fr_0.92fr] lg:py-20">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200/80 bg-white/90 px-4 py-1.5 text-xs sm:text-sm font-extrabold text-indigo-900 shadow-xs backdrop-blur-md dark:border-indigo-500/20 dark:bg-indigo-950/40 dark:text-indigo-200">
            <span class="flex h-2 w-2 rounded-full bg-emerald-500 ring-4 ring-emerald-500/20 animate-pulse"></span>
            Học Toán Tiểu Học Lớp 1–5 · Chuẩn GDPT 2018
          </div>
          <h1 class="poster-headline mt-6 text-4xl font-black leading-[1.08] tracking-[-0.045em] text-slate-950 sm:text-5xl md:text-6xl dark:text-white">
            Luyện đúng bài,<br />
            <span class="bg-gradient-to-r from-indigo-600 via-violet-600 to-sky-500 bg-clip-text text-transparent dark:from-indigo-400 dark:via-violet-400 dark:to-sky-300">hiểu chắc từng bước</span>
          </h1>
          <p class="mt-6 max-w-2xl text-base sm:text-lg font-medium leading-relaxed text-slate-600 dark:text-slate-300">
            Nền tảng luyện tập Toán trực quan sinh động theo từng chủ đề bài học trên lớp. Có gợi ý tư duy 3 nấc nhẹ nhàng và lời giải từng bước chi tiết giúp con tự tin học tốt.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#chon-lop" class="poster-primary-button group inline-flex items-center justify-center gap-2.5 rounded-2xl px-7 py-4 text-base font-black text-white transition hover:-translate-y-0.5 active:scale-[0.98]">
              <span>Bắt đầu chọn bài học</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a href="/thanh-tich" class="inline-flex items-center justify-center gap-2.5 rounded-2xl border border-slate-200/90 bg-white/90 px-7 py-4 text-base font-black text-slate-700 shadow-xs backdrop-blur-md transition hover:-translate-y-0.5 hover:border-amber-300 hover:bg-amber-50/50 hover:text-amber-800 dark:border-slate-700 dark:bg-slate-900/90 dark:text-slate-200 dark:hover:border-amber-500/40 dark:hover:bg-amber-950/20">
              <span>🏆</span>
              <span>Bảng vàng thành tích</span>
            </a>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-2.5 text-xs sm:text-sm font-bold text-slate-500 dark:text-slate-400">
            <span>Toán lớp 1–5</span>
            <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">·</span>
            <span>Gợi ý tư duy 3 nấc</span>
            <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">·</span>
            <span>Lời giải từng bước</span>
            <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">·</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">Miễn phí 100% · Không quảng cáo</span>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-xl">
          <div class="poster-character-stage" aria-hidden="true">
            <span class="poster-orb poster-orb-one"></span><span class="poster-orb poster-orb-two"></span>
            <img src="/models/mascots/squirrel-bear-poster.webp" alt="" width="1050" height="700" fetchpriority="high" class="poster-character-image" />
          </div>
          <div class="poster-grade-panel relative overflow-hidden rounded-[2rem] border border-slate-200/90 bg-white p-5 shadow-2xl dark:border-slate-700/80 dark:bg-slate-900 md:p-6">
            <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-4 dark:border-slate-800">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.16em] text-indigo-600 dark:text-indigo-400">Lộ trình bài học</p>
                <h2 class="mt-1 text-xl font-black text-slate-950 dark:text-white md:text-2xl">Chọn lớp đang học</h2>
              </div>
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-indigo-50 to-sky-50 text-2xl shadow-xs dark:from-slate-800 dark:to-slate-800">🎓</span>
            </div>
            <div class="mt-4 grid gap-2.5">
              {grades.map((item) => (
                <a
                  href={`/lop-${item.grade}`}
                  class="group flex items-center gap-3.5 rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-indigo-400 hover:shadow-md dark:border-slate-700 dark:bg-slate-800/95 dark:hover:border-indigo-400 dark:hover:bg-slate-750"
                  aria-label={`Mở ${item.title}`}
                >
                  <span class={`grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gradient-to-br text-lg font-black text-white shadow-md ring-2 ring-white/90 dark:ring-slate-700 ${item.badgeGradient}`}>
                    {item.grade}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-base font-black text-slate-950 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                      {item.title}
                    </span>
                    <span class="mt-0.5 block truncate text-xs font-semibold text-slate-600 dark:text-slate-300">
                      {item.short}
                    </span>
                  </span>
                  <img
                    src={`/models/grade-mascots/${item.grade}-compact.webp`}
                    alt=""
                    aria-hidden="true"
                    width="56"
                    height="56"
                    class="h-11 w-11 shrink-0 object-contain drop-shadow transition-transform duration-200 group-hover:scale-110"
                  />
                  <span
                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-sm font-black text-slate-700 transition-all duration-200 group-hover:bg-indigo-600 group-hover:text-white group-hover:translate-x-0.5 dark:bg-slate-700 dark:text-slate-200 dark:group-hover:bg-indigo-500"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </a>
              ))}
            </div>
          </div>
          <div class="absolute -bottom-3 -right-3 -z-10 h-full w-full rounded-[2rem] bg-gradient-to-br from-indigo-200/60 to-sky-200/50 blur-sm dark:from-indigo-500/10 dark:to-sky-500/10"></div>
        </div>
      </div>
    </section>

    <!-- Thanh tiếp tục học -->
    <ContinueLearning />

    <!-- Danh sách các khối lớp -->
    <section id="chon-lop" class="bg-white py-16 dark:bg-slate-950 md:py-20 transition-colors">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-black uppercase tracking-[0.16em] text-indigo-600 dark:text-indigo-400">Lộ trình 5 khối lớp</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 dark:text-white md:text-5xl">Mỗi lớp một chặng khám phá</h2>
          <p class="mt-4 max-w-2xl text-base font-medium leading-relaxed text-slate-600 dark:text-slate-400">
            Từ những phép tính đầu tiên đến phân số, phần trăm và toán chuyển động, bé luôn có một người bạn đồng hành thú vị trong từng chủ đề bài học.
          </p>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-5">
          {grades.map((item) => (
            <a
              href={`/lop-${item.grade}`}
              class={`poster-grade-card group relative flex min-h-[350px] flex-col justify-between overflow-hidden rounded-[2rem] border bg-white p-6 shadow-sm dark:bg-slate-900/90 dark:shadow-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2.5 ${item.border} ${item.hoverBorder} ${item.hoverShadow}`}
            >
              <!-- Nền gradient mờ tinh tế theo tông màu lớp -->
              <div class={`pointer-events-none absolute inset-0 bg-gradient-to-br ${item.lightTint} opacity-40 transition-opacity duration-300 group-hover:opacity-75 dark:opacity-0`}></div>

              <!-- Linh vật khối lớp tương ứng -->
              <img
                src={`/models/grade-mascots/${item.grade}-compact.webp`}
                alt=""
                aria-hidden="true"
                width="224"
                height="224"
                loading="lazy"
                class="poster-grade-ghost"
              />

              <!-- Phần trên: Badge số lớp & số chủ đề -->
              <div class="relative z-10 flex items-start justify-between gap-3">
                <span class={`grid h-13 w-13 place-items-center rounded-2xl bg-gradient-to-br text-2xl font-black text-white shadow-md transition-transform duration-300 group-hover:scale-105 ring-4 ring-white/90 dark:ring-slate-800 ${item.badgeGradient}`}>
                  {item.grade}
                </span>
                <span class={`inline-flex items-center gap-1 rounded-full border px-3 py-1 text-xs font-black shadow-2xs backdrop-blur-sm ${item.pillBg}`}>
                  <span>{item.count} chủ đề</span>
                </span>
              </div>

              <!-- Thân thẻ: Tiêu đề, slogan ngắn & mô tả -->
              <div class="relative z-10 my-4 flex-1">
                <p class={`text-xs font-black uppercase tracking-wider ${item.text}`}>
                  {item.short}
                </p>
                <h3 class="mt-1 text-xl font-black tracking-tight text-slate-950 transition-colors group-hover:text-indigo-600 dark:text-white dark:group-hover:text-indigo-400">
                  {item.title}
                </h3>
                <p class="mt-2 text-xs sm:text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-400 max-w-[72%]">
                  {item.description}
                </p>
              </div>

              <!-- Chân thẻ: Lời kêu gọi hành động & mũi tên nhấc nổi (không gạch ngang cắt qua hình thú) -->
              <div class="relative z-10 mt-auto flex items-center justify-between pt-3">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400">Xem lộ trình</span>
                <span class={`inline-flex items-center gap-1.5 text-xs font-black transition-transform duration-300 group-hover:translate-x-1.5 ${item.text}`}>
                  <span>Khám phá</span>
