---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PracticeModuleCard from '../components/PracticeModuleCard.astro';
import { grade2PracticeModes, grade2PracticeModules, getGrade2ModulesBySemester } from '../data/grade2Curriculum';
const sections = [
  { eyebrow: 'Học kỳ I', title: 'Củng cố số học và phép tính có nhớ', description: 'Ôn số đến 100, cộng trừ, đo lường, hình phẳng và thời gian.', modules: getGrade2ModulesBySemester(1), accent: 'text-cyan-700', dot: 'bg-cyan-500', background: 'bg-white', hover: 'group-hover:bg-cyan-600' },
  { eyebrow: 'Học kỳ II', title: 'Mở rộng đến 1 000, nhân chia và dữ liệu', description: 'Nhân chia, số có ba chữ số, tiền Việt Nam, thống kê và xác suất.', modules: getGrade2ModulesBySemester(2), accent: 'text-blue-700', dot: 'bg-blue-500', background: 'bg-slate-50', hover: 'group-hover:bg-blue-600' },
];
---
<BaseLayout title="Toán lớp 2 – Trạng Toán" description="Mười bốn nhóm luyện tập Toán lớp 2 trực quan, bám sát nội dung học trên lớp và sách giáo khoa.">
  <SiteHeader compact />
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-cyan-50 via-white to-blue-50">
      <div class="absolute inset-0 opacity-35 [background-image:radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:28px_28px]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 md:px-8 lg:grid-cols-[1fr_380px] lg:py-20">
        <div><div class="inline-flex items-center gap-2 rounded-full border border-cyan-200 bg-white px-4 py-2 text-sm font-black text-cyan-700 shadow-sm">🐱 Chương trình luyện tập lớp 2</div><h1 class="mt-6 text-4xl font-black tracking-[-0.04em] text-slate-950 md:text-6xl">Luyện chắc kiến thức, <span class="text-sky-600">tự tin giải Toán</span></h1><p class="mt-5 max-w-3xl text-lg font-medium leading-8 text-slate-600">Chọn chủ đề tương ứng với bài đang học. Mỗi lượt luyện ngắn, trực quan và có phản hồi ngay sau khi trả lời.</p><div class="mt-7 flex flex-wrap gap-3"><span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm">✓ {grade2PracticeModules.length} mục đã mở</span><span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm">✓ Hai học kỳ</span><span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm">✓ Bài tập trực quan</span></div><a href="#hoc-ky-1" class="mt-8 inline-flex items-center gap-3 rounded-2xl bg-sky-600 px-6 py-4 font-black text-white shadow-xl shadow-sky-200 transition hover:-translate-y-1 hover:bg-sky-700">Chọn bài để luyện <span>↓</span></a></div>
        <div class="hidden lg:block"><div class="rounded-[2rem] border-4 border-white bg-white p-5 shadow-2xl"><div class="flex items-center justify-between"><div><p class="text-sm font-black text-sky-700">Toán lớp 2</p><p class="mt-1 text-xl font-black text-slate-900">Hôm nay mình luyện gì?</p></div><span class="text-5xl">🐱</span></div><div class="mt-5 grid grid-cols-2 gap-3">{grade2PracticeModes.map((mode) => <div class="rounded-2xl bg-slate-50 p-4"><span class="text-2xl">{mode.icon}</span><p class="mt-2 text-sm font-black text-slate-800">{mode.title}</p><p class="mt-1 text-xs font-semibold text-slate-500">{mode.questionCount} câu · {mode.estimatedMinutes} phút</p></div>)}</div></div></div>
      </div>
    </section>
    {sections.map((section, index) => <section id={index === 0 ? 'hoc-ky-1' : 'hoc-ky-2'} class={`py-14 ${section.background}`}><div class="mx-auto max-w-7xl px-4 md:px-8"><div class="flex items-start gap-4"><span class={`mt-2 h-12 w-1.5 rounded-full ${section.dot}`}></span><div><p class={`text-sm font-extrabold tracking-[0.14em] ${section.accent}`}>{section.eyebrow}</p><h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">{section.title}</h2><p class="mt-2 font-medium text-slate-500">{section.description}</p></div></div><div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">{section.modules.map((practiceModule) => <PracticeModuleCard practiceModule={practiceModule} grade={2} accent={section.hover} />)}</div></div></section>)}
  </main>
  <SiteFooter />
</BaseLayout>
