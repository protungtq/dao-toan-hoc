---
import BaseLayout from '../layouts/BaseLayout.astro';
import { grade2PracticeModes, grade2PracticeModules, getGrade2ModulesBySemester } from '../data/grade2Curriculum';

const sections = [
  {
    semester: 1 as const,
    eyebrow: 'Học kỳ I',
    title: 'Củng cố số học và làm quen phép tính có nhớ',
    modules: getGrade2ModulesBySemester(1),
    accent: 'text-cyan-600',
    hover: 'group-hover:bg-cyan-600',
    background: 'bg-white',
    cardBackground: 'bg-white',
  },
  {
    semester: 2 as const,
    eyebrow: 'Học kỳ II',
    title: 'Mở rộng đến 1 000, nhân chia và dữ liệu',
    modules: getGrade2ModulesBySemester(2),
    accent: 'text-blue-600',
    hover: 'group-hover:bg-blue-600',
    background: 'bg-slate-50',
    cardBackground: 'bg-white',
  },
];

function getStatusLabel(status: string) {
  if (status === 'ready') return 'Có thể luyện';
  if (status === 'building') return 'Đang xây dựng';
  return 'Dự kiến';
}

function getStatusClass(status: string) {
  if (status === 'ready') return 'bg-emerald-100 text-emerald-700';
  if (status === 'building') return 'bg-amber-100 text-amber-700';
  return 'bg-slate-100 text-slate-500';
}
---

<BaseLayout
  title="Toán lớp 2 – Đảo Toán Học"
  description="Mười bốn nhóm luyện tập Toán lớp 2, bám sát nội dung học trên lớp và sách giáo khoa."
>
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 md:px-8">
      <a href="/" class="flex items-center gap-3">
        <div class="grid h-10 w-10 place-items-center rounded-xl bg-slate-950 font-black text-white">∑</div>
        <div>
          <p class="font-black text-slate-950">Đảo Toán Học</p>
          <p class="text-xs font-semibold text-slate-500">Luyện tập thông minh</p>
        </div>
      </a>
      <a href="/" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-black text-slate-600 transition hover:bg-slate-50">← Trang chủ</a>
    </div>
  </header>

  <main>
    <section class="relative overflow-hidden bg-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(103,232,249,0.32),transparent_32%),radial-gradient(circle_at_85%_20%,rgba(147,197,253,0.30),transparent_30%)]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 md:px-8 lg:grid-cols-[1fr_auto]">
        <div>
          <div class="inline-flex items-center rounded-full border border-cyan-200 bg-cyan-50 px-4 py-2 text-sm font-extrabold text-cyan-700">Chương trình luyện tập lớp 2</div>
          <h1 class="mt-6 text-4xl font-black tracking-[-0.04em] text-slate-950 md:text-6xl">Toán lớp 2</h1>
          <p class="mt-5 max-w-3xl text-lg font-medium leading-8 text-slate-600">Chọn nội dung tương ứng với bài đang học trên lớp. Các mục luyện tập dùng để củng cố kiến thức, không bắt buộc hoàn thành tuần tự.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <span class="rounded-full bg-slate-100 px-4 py-2 text-sm font-bold text-slate-600">{grade2PracticeModules.length} mục luyện tập</span>
            <span class="rounded-full bg-slate-100 px-4 py-2 text-sm font-bold text-slate-600">Học kỳ I và II</span>
            <span class="rounded-full bg-slate-100 px-4 py-2 text-sm font-bold text-slate-600">Bài tập trực quan</span>
          </div>
        </div>
        <div class="hidden h-36 w-36 place-items-center rounded-[2.5rem] bg-gradient-to-br from-cyan-400 to-blue-600 text-7xl font-black text-white shadow-2xl shadow-cyan-200 lg:grid">2</div>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-white">
      <div class="mx-auto grid max-w-7xl gap-4 px-4 py-6 sm:grid-cols-2 md:grid-cols-4 md:px-8">
        {grade2PracticeModes.map((mode) => (
          <div class="flex items-center gap-3 rounded-2xl bg-slate-50 p-4">
            <span class="text-2xl">{mode.icon}</span>
            <div><p class="font-black text-slate-900">{mode.title}</p><p class="text-xs font-semibold text-slate-500">{mode.questionCount} câu · khoảng {mode.estimatedMinutes} phút</p></div>
          </div>
        ))}
      </div>
    </section>

    {sections.map((section) => (
      <section class={`py-16 ${section.background}`}>
        <div class="mx-auto max-w-7xl px-4 md:px-8">
          <p class={`font-extrabold uppercase tracking-[0.16em] ${section.accent}`}>{section.eyebrow}</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">{section.title}</h2>
          <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {section.modules.map((practiceModule) => (
              <article class={`group flex flex-col rounded-3xl border border-slate-200 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl ${section.cardBackground}`}>
                <div class="flex items-start justify-between gap-4">
                  <div class={`grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br text-2xl text-white shadow-lg ${practiceModule.color}`}>{practiceModule.icon}</div>
                  <span class={`rounded-full px-3 py-1 text-xs font-extrabold ${getStatusClass(practiceModule.developmentStatus)}`}>{getStatusLabel(practiceModule.developmentStatus)}</span>
                </div>
                <p class="mt-5 text-xs font-extrabold uppercase tracking-wider text-slate-400">Mục {practiceModule.number} · Bài {practiceModule.textbookLessons[0]}–{practiceModule.textbookLessons[practiceModule.textbookLessons.length - 1]}</p>
                <h3 class="mt-2 text-xl font-black text-slate-950">{practiceModule.title}</h3>
                <p class="mt-3 flex-1 font-medium leading-7 text-slate-500">{practiceModule.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {practiceModule.skills.slice(0, 3).map((skill) => <span class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">{skill.icon} {skill.title}</span>)}
                  {practiceModule.skills.length > 3 && <span class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-500">+{practiceModule.skills.length - 3}</span>}
                </div>
                {practiceModule.developmentStatus === 'ready' ? (
                  <a href={`/luyen-tap/lop-2/${practiceModule.slug}`} class={`mt-6 flex items-center justify-between rounded-2xl bg-slate-950 px-5 py-4 font-black text-white transition ${section.hover}`}><span>Bắt đầu luyện</span><span>→</span></a>
                ) : (
                  <div class="mt-6 rounded-2xl bg-slate-100 px-5 py-4 text-center font-black text-slate-400">Đang chuẩn bị nội dung</div>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>

  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-8 text-sm font-semibold text-slate-500 md:flex-row md:items-center md:justify-between md:px-8">
      <p>© 2026 Đảo Toán Học</p><a href="/" class="hover:text-slate-900">Về trang chủ</a>
    </div>
  </footer>
</BaseLayout>
