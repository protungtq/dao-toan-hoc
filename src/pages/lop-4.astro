---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PracticeModuleCard from '../components/PracticeModuleCard.astro';
import { grade4PracticeModes, grade4PracticeModules, getGrade4ModulesBySemester, getGrade4ReadyModules } from '../data/grade4Curriculum';

const readyModules = getGrade4ReadyModules();
const sections = [
  { eyebrow: 'Học kỳ I', title: 'Số lớn, góc và nền tảng tính toán', description: 'Ôn số đến 100 000, khám phá số đến lớp triệu, đo góc, đổi đơn vị và củng cố cộng trừ.', modules: getGrade4ModulesBySemester(1), accent: 'text-orange-700', dot: 'bg-orange-500', background: 'bg-white', hover: 'group-hover:bg-orange-600' },
  { eyebrow: 'Học kỳ II', title: 'Nhân chia, dữ liệu và phân số', description: 'Hoàn thiện phép nhân chia, thống kê, xác suất và các phép tính với phân số.', modules: getGrade4ModulesBySemester(2), accent: 'text-amber-700', dot: 'bg-amber-500', background: 'bg-slate-50', hover: 'group-hover:bg-amber-600' },
];
---

<BaseLayout title="Toán lớp 4 – Trạng Toán" description="Mười ba nhóm luyện tập Toán lớp 4 bám sát bộ sách Kết nối tri thức với cuộc sống, từ số có nhiều chữ số đến phân số, hình học và dữ liệu.">
  <SiteHeader compact />
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-orange-50 via-white to-amber-50">
      <div class="absolute inset-0 opacity-35 [background-image:radial-gradient(#fb923c_1px,transparent_1px)] [background-size:28px_28px]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 md:px-8 lg:grid-cols-[1fr_380px] lg:py-20">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-white px-4 py-2 text-sm font-black text-orange-700 shadow-sm">🐻 Chương trình luyện tập lớp 4</div>
          <h1 class="mt-6 text-4xl font-black tracking-[-0.04em] text-slate-950 md:text-6xl">Hiểu số lớn, <span class="text-orange-600">vững tư duy Toán</span></h1>
          <p class="mt-5 max-w-3xl text-lg font-medium leading-8 text-slate-600">Nội dung lớp 4 được gom thành 13 chủ đề theo tiến trình sách giáo khoa, từ ôn tập đầu năm đến phân số và tổng kết cuối năm.</p>
          <div class="mt-7 flex flex-wrap gap-3"><span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm">✓ {readyModules.length}/{grade4PracticeModules.length} mục đã có bài luyện</span><span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm">✓ 73 bài trong sách</span><span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm">✓ Hai học kỳ</span></div>
          <a href="#hoc-ky-1" class="mt-8 inline-flex items-center gap-3 rounded-2xl bg-orange-600 px-6 py-4 font-black text-white shadow-xl shadow-orange-200 transition hover:-translate-y-1 hover:bg-orange-700">Xem chương trình <span>↓</span></a>
        </div>
        <div class="hidden lg:block"><div class="rounded-[2rem] border-4 border-white bg-white p-5 shadow-2xl"><div class="flex items-center justify-between"><div><p class="text-sm font-black text-orange-700">Toán lớp 4</p><p class="mt-1 text-xl font-black text-slate-900">Mỗi lượt học vừa sức</p></div><span class="text-5xl">🐻</span></div><div class="mt-5 grid grid-cols-2 gap-3">{grade4PracticeModes.map((mode) => <div class="rounded-2xl bg-slate-50 p-4"><span class="text-2xl">{mode.icon}</span><p class="mt-2 text-sm font-black text-slate-800">{mode.title}</p><p class="mt-1 text-xs font-semibold text-slate-500">{mode.questionCount} câu · {mode.estimatedMinutes} phút</p></div>)}</div></div></div>
      </div>
    </section>
    {sections.map((section, index) => <section id={index === 0 ? 'hoc-ky-1' : 'hoc-ky-2'} class={`py-14 ${section.background}`}><div class="mx-auto max-w-7xl px-4 md:px-8"><div class="flex items-start gap-4"><span class={`mt-2 h-12 w-1.5 rounded-full ${section.dot}`}></span><div><p class={`text-sm font-extrabold tracking-[0.14em] ${section.accent}`}>{section.eyebrow}</p><h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 md:text-4xl">{section.title}</h2><p class="mt-2 font-medium text-slate-500">{section.description}</p></div></div><div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">{section.modules.map((practiceModule) => <PracticeModuleCard practiceModule={practiceModule} grade={4} accent={section.hover} />)}</div></div></section>)}
  </main>
  <SiteFooter />
</BaseLayout>
