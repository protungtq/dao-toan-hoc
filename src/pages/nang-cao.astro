---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AdvancedLogicMathGame from '../components/AdvancedLogicMathGame';

const advancedSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Toán Nâng Cao & Tư Duy IQ Tiểu Học',
  description: 'Hệ thống các bài toán tư duy IQ tiểu học: toán que diêm, xếp hàng & bậc thang, khoảng cách trồng cây, biểu đồ Venn, xem đồng hồ & lịch tuần, tháp số và toán thám tử theo sách 1001 Bài toán tư duy.',
  provider: {
    '@type': 'Organization',
    name: 'Trạng Toán',
    url: 'https://trangtoan.com',
  },
  educationalLevel: 'Tiểu học (Lớp 1 - 5)',
  inLanguage: 'vi',
};
---

<BaseLayout
  title="Toán Nâng Cao & Tư Duy IQ Tiểu Học – Trạng Toán"
  description="Luyện tập các dạng toán tư duy IQ tiểu học: toán que diêm, xếp hàng & bậc thang, trồng cây, biểu đồ Venn, xem đồng hồ & lịch tuần, tháp số và toán thám tử."
  canonical="/nang-cao"
>
  <script type="application/ld+json" set:html={JSON.stringify(advancedSchema)} />
  <SiteHeader compact />
  <main class="min-h-[85vh] py-4 sm:py-8 bg-gradient-to-b from-indigo-50/40 via-white to-purple-50/30 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
    <AdvancedLogicMathGame client:load />
  </main>
  <SiteFooter />
</BaseLayout>
