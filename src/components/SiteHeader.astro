---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/80 shadow-[0_4px_20px_-4px_rgba(15,23,42,0.06)] backdrop-blur-xl transition-colors duration-200 dark:border-slate-800/80 dark:bg-slate-950/80">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2.5 sm:py-3 md:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3 transition-transform hover:-translate-y-0.5" aria-label="Về trang chủ Trạng Toán">
      <div class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 via-violet-500 to-sky-400 p-0.5 shadow-md shadow-indigo-500/20 transition-all duration-300 group-hover:scale-105 group-hover:shadow-indigo-500/35">
        <img src="/icon/android-chrome-192x192.png" alt="" class="h-full w-full rounded-[0.875rem] object-cover" />
      </div>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <p class="poster-brand text-lg font-black tracking-tight text-slate-900 dark:text-white">Trạng Toán</p>
          <span class="hidden rounded-md bg-indigo-50 px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-300 sm:inline-block">Lớp 1–5</span>
        </div>
        <p class="hidden truncate text-xs font-semibold text-slate-500 dark:text-slate-400 sm:block">Luyện mỗi ngày · Giỏi từng bước</p>
      </div>
    </a>

    {compact ? (
      <nav class="flex shrink-0 items-center gap-2" aria-label="Điều hướng nhanh">
        <ThemeToggle compact />
        <a href="/thanh-tich" class="inline-flex items-center gap-1.5 rounded-xl border border-amber-200/80 bg-amber-50/80 px-3 py-2 text-sm font-bold text-amber-800 shadow-xs backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:bg-amber-100 hover:shadow-sm dark:border-amber-500/20 dark:bg-amber-400/10 dark:text-amber-300 dark:hover:bg-amber-400/20">
          <span aria-hidden="true">🏆</span><span class="hidden sm:inline"> Thành tích</span>
        </a>
        <a href="/minigame" class="inline-flex items-center gap-1.5 rounded-xl border border-violet-200/80 bg-violet-50/80 px-3 py-2 text-sm font-bold text-violet-800 shadow-xs backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:bg-violet-100 hover:shadow-sm dark:border-violet-500/20 dark:bg-violet-400/10 dark:text-violet-300 dark:hover:bg-violet-400/20">
          <span aria-hidden="true">🎟️</span><span class="hidden sm:inline"> Minigame</span>
        </a>
        <a href="/" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200/90 bg-white/90 px-3 py-2 text-sm font-bold text-slate-700 shadow-xs backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:border-indigo-300 hover:bg-indigo-50/60 hover:text-indigo-700 dark:border-slate-700 dark:bg-slate-900/90 dark:text-slate-200 dark:hover:border-indigo-500 dark:hover:bg-indigo-950/40 dark:hover:text-indigo-300">
          <span aria-hidden="true">←</span><span class="hidden sm:inline">Trang chủ</span>
        </a>
      </nav>
    ) : (
      <div class="flex items-center gap-2">
        <nav class="flex items-center gap-1.5" aria-label="Điều hướng chính">
          <div class="hidden md:flex items-center gap-1 rounded-2xl border border-slate-200/70 bg-slate-100/70 p-1 dark:border-slate-800/80 dark:bg-slate-900/70">
            <a href="#chon-lop" class="rounded-xl px-3.5 py-1.5 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-indigo-600 hover:shadow-xs dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-indigo-300">Chọn lớp</a>
            <a href="#hoc-ngay" class="rounded-xl px-3.5 py-1.5 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-indigo-600 hover:shadow-xs dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-indigo-300">Học ngay</a>
            <a href="#phu-huynh" class="rounded-xl px-3.5 py-1.5 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-indigo-600 hover:shadow-xs dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-indigo-300">Phụ huynh</a>
          </div>

          <a href="/thanh-tich" class="inline-flex items-center gap-1.5 rounded-xl border border-amber-200/80 bg-amber-50/80 px-3 py-2 text-sm font-bold text-amber-800 shadow-xs backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:bg-amber-100 hover:shadow-sm dark:border-amber-500/20 dark:bg-amber-400/10 dark:text-amber-300 dark:hover:bg-amber-400/20">
            <span aria-hidden="true">🏆</span><span class="hidden sm:inline"> Thành tích</span>
          </a>
          <a href="/minigame" class="inline-flex items-center gap-1.5 rounded-xl border border-violet-200/80 bg-violet-50/80 px-3 py-2 text-sm font-bold text-violet-800 shadow-xs backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:bg-violet-100 hover:shadow-sm dark:border-violet-500/20 dark:bg-violet-400/10 dark:text-violet-300 dark:hover:bg-violet-400/20">
            <span aria-hidden="true">🎟️</span><span>Minigame</span>
          </a>
          <ThemeToggle />
        </nav>
      </div>
    )}
  </div>
</header>

