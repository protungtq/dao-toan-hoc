---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 md:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label="Về trang chủ Trạng Toán">
      <img src="/icon/android-chrome-192x192.png" alt="" class="h-11 w-11 shrink-0 rounded-2xl shadow-md transition group-hover:-rotate-3 group-hover:scale-105" />
      <div class="min-w-0">
        <p class="text-lg font-black tracking-tight text-slate-950">Trạng Toán</p>
        <p class="truncate text-xs font-bold text-slate-500">Luyện mỗi ngày · Giỏi từng bước</p>
      </div>
    </a>

    {compact ? (
      <a href="/" class="shrink-0 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-black text-slate-600 transition hover:border-violet-300 hover:bg-violet-50 hover:text-violet-700">← Trang chủ</a>
    ) : (
      <nav class="hidden items-center gap-1 md:flex" aria-label="Điều hướng chính">
        <a href="#chon-lop" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-violet-50 hover:text-violet-700">Chọn lớp</a>
        <a href="#hoc-ngay" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-violet-50 hover:text-violet-700">Học ngay</a>
        <a href="#phu-huynh" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-violet-50 hover:text-violet-700">Phụ huynh</a>
      </nav>
    )}
  </div>
</header>
