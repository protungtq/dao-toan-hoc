---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/82 shadow-[0_1px_0_rgba(15,23,42,0.02)] backdrop-blur-xl dark:border-slate-800 dark:bg-slate-950/82">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 md:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label="Về trang chủ Trạng Toán">
      <img src="/icon/android-chrome-192x192.png" alt="" class="h-11 w-11 shrink-0 rounded-2xl shadow-md transition group-hover:-rotate-3 group-hover:scale-105" />
      <div class="min-w-0">
        <p class="text-lg font-black tracking-tight text-slate-950 dark:text-white">Trạng Toán</p>
        <p class="truncate text-xs font-bold text-slate-500 dark:text-slate-400">Luyện mỗi ngày · Giỏi từng bước</p>
      </div>
    </a>

    {compact ? (
      <nav class="flex shrink-0 items-center gap-2" aria-label="Điều hướng nhanh">
        <ThemeToggle compact />
        <a href="/thanh-tich" class="rounded-xl bg-amber-50 px-3 py-2 text-sm font-black text-amber-700 transition hover:bg-amber-100 dark:bg-amber-400/10 dark:text-amber-300 dark:hover:bg-amber-400/20"><span aria-hidden="true">🏆</span><span class="hidden sm:inline"> Thành tích</span></a>
        <a href="/" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-black text-slate-600 transition hover:border-violet-300 hover:bg-violet-50 hover:text-violet-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-violet-500 dark:hover:bg-violet-400/10 dark:hover:text-violet-300">← <span class="hidden sm:inline">Trang chủ</span></a>
      </nav>
    ) : (
      <>
        <div class="md:hidden"><ThemeToggle compact /></div>
        <nav class="hidden items-center gap-1 rounded-2xl border border-slate-200/70 bg-slate-50/70 p-1 md:flex dark:border-slate-800 dark:bg-slate-900/70" aria-label="Điều hướng chính">
          <a href="#chon-lop" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-violet-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-violet-300">Chọn lớp</a>
          <a href="#hoc-ngay" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-violet-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-violet-300">Học ngay</a>
          <a href="/thanh-tich" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-amber-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-amber-300">Thành tích</a>
          <a href="#phu-huynh" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-violet-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-violet-300">Phụ huynh</a>
          <ThemeToggle />
        </nav>
      </>
    )}
  </div>
</header>
