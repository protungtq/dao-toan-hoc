---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 shadow-xs backdrop-blur-xl dark:border-slate-800 dark:bg-slate-950/90">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 md:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label="Về trang chủ Trạng Toán">
      <img src="/icon/android-chrome-192x192.png" alt="" class="h-10 w-10 shrink-0 rounded-2xl shadow-md transition group-hover:-rotate-3 group-hover:scale-105" />
      <div class="min-w-0">
        <p class="poster-brand text-lg font-black tracking-tight text-slate-900 dark:text-white">Trạng Toán</p>
        <p class="hidden sm:block truncate text-xs font-semibold text-slate-500 dark:text-slate-400">Luyện mỗi ngày · Giỏi từng bước</p>
      </div>
    </a>

    {compact ? (
      <nav class="flex shrink-0 items-center gap-2" aria-label="Điều hướng nhanh">
        <ThemeToggle compact />
        <a href="/thanh-tich" class="rounded-xl bg-amber-50 px-3 py-2 text-sm font-bold text-amber-700 transition hover:bg-amber-100 dark:bg-amber-400/10 dark:text-amber-300 dark:hover:bg-amber-400/20">
          <span aria-hidden="true">🏆</span><span class="hidden sm:inline"> Thành tích</span>
        </a>
        <a href="/minigame" class="rounded-xl bg-violet-50 px-3 py-2 text-sm font-bold text-violet-700 transition hover:bg-violet-100 dark:bg-violet-400/10 dark:text-violet-300 dark:hover:bg-violet-400/20">
          <span aria-hidden="true">🎟️</span><span class="hidden sm:inline"> Minigame</span>
        </a>
        <a href="/" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-slate-700 transition hover:border-violet-300 hover:bg-violet-50 hover:text-violet-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-violet-500 dark:hover:bg-violet-400/10">
          ← <span class="hidden sm:inline">Trang chủ</span>
        </a>
      </nav>
    ) : (
      <div class="flex items-center gap-2">
        <nav class="flex items-center gap-1.5" aria-label="Điều hướng chính">
          <div class="hidden md:flex items-center gap-1 rounded-2xl border border-slate-200/70 bg-slate-50/70 p-1 dark:border-slate-800 dark:bg-slate-900/70">
            <a href="#chon-lop" class="rounded-xl px-3.5 py-2 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-violet-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-violet-300">Chọn lớp</a>
            <a href="#hoc-ngay" class="rounded-xl px-3.5 py-2 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-violet-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-violet-300">Học ngay</a>
            <a href="#phu-huynh" class="rounded-xl px-3.5 py-2 text-sm font-bold text-slate-600 transition hover:bg-white hover:text-violet-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-violet-300">Phụ huynh</a>
          </div>

          <a href="/thanh-tich" class="flex items-center gap-1.5 rounded-xl border border-amber-200 bg-amber-50/80 px-3 py-2 text-sm font-bold text-amber-800 transition hover:bg-amber-100 dark:border-amber-500/20 dark:bg-amber-400/10 dark:text-amber-300 dark:hover:bg-amber-400/20">
            <span aria-hidden="true">🏆</span><span class="hidden sm:inline"> Thành tích</span>
          </a>
          <a href="/minigame" class="flex items-center gap-1.5 rounded-xl border border-violet-200 bg-violet-50/80 px-3 py-2 text-sm font-bold text-violet-800 transition hover:bg-violet-100 dark:border-violet-500/20 dark:bg-violet-400/10 dark:text-violet-300 dark:hover:bg-violet-400/20">
            <span aria-hidden="true">🎟️</span><span>Minigame</span>
          </a>
          <ThemeToggle />
        </nav>
      </div>
    )}
  </div>
</header>
