<div id="pwa-offline" hidden class="fixed inset-x-3 bottom-3 z-[80] mx-auto max-w-lg rounded-2xl bg-slate-950 px-5 py-4 text-center text-sm font-black text-white shadow-2xl" role="status">
  📡 Đang ngoại tuyến · Bé vẫn có thể mở những bài đã học
</div>

<div id="pwa-update" hidden class="fixed inset-x-3 bottom-3 z-[90] mx-auto max-w-lg rounded-3xl border border-violet-200 bg-white p-4 shadow-2xl" role="status">
  <div class="flex items-center gap-4">
    <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-violet-100 text-2xl">✨</span>
    <div class="min-w-0 flex-1"><p class="font-black text-slate-950">Đã có bản mới</p><p class="mt-1 text-xs font-semibold text-slate-500">Cập nhật để dùng nội dung mới nhất.</p></div>
    <button id="pwa-update-button" type="button" class="rounded-xl bg-violet-600 px-4 py-3 text-sm font-black text-white">Cập nhật</button>
  </div>
</div>

<button id="pwa-install" hidden type="button" class="fixed bottom-4 right-4 z-[70] items-center gap-2 rounded-2xl bg-violet-600 px-5 py-4 font-black text-white shadow-2xl shadow-violet-300 transition hover:-translate-y-1 hover:bg-violet-700" aria-haspopup="dialog">
  <span aria-hidden="true">📲</span> Cài Trạng Toán
</button>

<dialog id="pwa-ios-guide" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-[2rem] border-0 p-0 shadow-2xl backdrop:bg-slate-950/60">
  <div class="p-6"><div class="flex items-start justify-between gap-4"><div><p class="text-sm font-black text-violet-700">Cài trên iPhone hoặc iPad</p><h2 class="mt-2 text-2xl font-black text-slate-950">Thêm Trạng Toán vào màn hình chính</h2></div><button id="pwa-ios-close" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 font-black text-slate-500" aria-label="Đóng">×</button></div><ol class="mt-6 space-y-4 font-semibold leading-7 text-slate-600"><li><b class="text-slate-950">1.</b> Mở trang bằng Safari.</li><li><b class="text-slate-950">2.</b> Nhấn nút Chia sẻ <span class="text-xl">⎋</span>.</li><li><b class="text-slate-950">3.</b> Chọn <b>Thêm vào màn hình chính</b>.</li></ol></div>
</dialog>

<script>
  import { trackEvent } from '../lib/analytics';

  type InstallPromptEvent = Event & {
    prompt: () => Promise<{ outcome: 'accepted' | 'dismissed' }>;
  };

  const installButton = document.querySelector<HTMLButtonElement>('#pwa-install');
  const updateBox = document.querySelector<HTMLElement>('#pwa-update');
  const updateButton = document.querySelector<HTMLButtonElement>('#pwa-update-button');
  const offlineBox = document.querySelector<HTMLElement>('#pwa-offline');
  const iosGuide = document.querySelector<HTMLDialogElement>('#pwa-ios-guide');
  const iosClose = document.querySelector<HTMLButtonElement>('#pwa-ios-close');
  let installPrompt: InstallPromptEvent | null = null;
  let waitingWorker: ServiceWorker | null = null;

  const standalone = window.matchMedia('(display-mode: standalone)').matches || ('standalone' in navigator && Boolean((navigator as Navigator & { standalone?: boolean }).standalone));
  const isiOS = /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const updateNetworkState = () => { if (offlineBox) offlineBox.hidden = navigator.onLine; };
  updateNetworkState();
  window.addEventListener('online', updateNetworkState);
  window.addEventListener('offline', updateNetworkState);

  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    installPrompt = event as InstallPromptEvent;
    if (installButton && !standalone) { installButton.hidden = false; installButton.classList.add('flex'); }
  });

  if (installButton && isiOS && !standalone) { installButton.hidden = false; installButton.classList.add('flex'); }
  installButton?.addEventListener('click', async () => {
    if (installPrompt) {
      const result = await installPrompt.prompt();
      if (result.outcome === 'accepted' && installButton) installButton.hidden = true;
      installPrompt = null;
    } else if (isiOS) iosGuide?.showModal();
  });
  iosClose?.addEventListener('click', () => iosGuide?.close());
  window.addEventListener('appinstalled', () => {
    if (installButton) installButton.hidden = true;
    trackEvent('pwa_install');
  });

  function showUpdate(worker: ServiceWorker) {
    waitingWorker = worker;
    if (updateBox) updateBox.hidden = false;
  }

  if ('serviceWorker' in navigator && import.meta.env.PROD) {
    window.addEventListener('load', async () => {
      const registration = await navigator.serviceWorker.register('/sw.js', { scope: '/' });
      if (registration.waiting) showUpdate(registration.waiting);
      registration.addEventListener('updatefound', () => {
        const worker = registration.installing;
        worker?.addEventListener('statechange', () => {
          if (worker.state === 'installed' && navigator.serviceWorker.controller) showUpdate(worker);
        });
      });
      let refreshing = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (refreshing) return;
        refreshing = true;
        location.reload();
      });
    });
  }
  updateButton?.addEventListener('click', () => waitingWorker?.postMessage({ type: 'SKIP_WAITING' }));
</script>
