---
interface Skill { icon: string; title: string }
interface Module {
  number: number; title: string; slug: string; description: string; icon: string;
  color: string; developmentStatus: string; textbookLessons: number[]; skills: Skill[];
}
interface Props { practiceModule: Module; grade: number; accent?: string; surface?: string }
const { practiceModule, grade, surface = 'bg-white' } = Astro.props;
const ready = practiceModule.developmentStatus === 'ready';
const href = `/luyen-tap/lop-${grade}/${practiceModule.slug}`;
---

{ready ? (
  <a href={href} class={`group relative flex h-full flex-col overflow-hidden rounded-[2rem] border border-slate-200/90 p-6 shadow-sm outline-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 hover:border-indigo-300 hover:shadow-[0_22px_45px_-10px_rgba(15,23,42,0.12)] focus-visible:ring-4 focus-visible:ring-indigo-300 dark:border-slate-800 dark:bg-slate-900/90 dark:shadow-none dark:hover:border-indigo-500/50 ${surface}`} aria-label={`Luyện ${practiceModule.title}`}>
    <div class="flex items-start justify-between gap-4">
      <span class={`grid h-13 w-13 place-items-center rounded-2xl bg-gradient-to-br text-2xl text-white shadow-md shadow-indigo-500/15 transition-transform duration-300 group-hover:scale-105 group-hover:rotate-2 ring-2 ring-white/90 dark:ring-slate-800 ${practiceModule.color}`}>{practiceModule.icon}</span>
      <span class="rounded-full border border-indigo-200/70 bg-indigo-50/80 px-3 py-1 text-xs font-black text-indigo-700 dark:border-indigo-400/20 dark:bg-indigo-400/10 dark:text-indigo-300 shadow-2xs">Chủ đề {practiceModule.number}</span>
    </div>
    <p class="mt-4 text-[11px] font-black tracking-wider text-slate-400 uppercase dark:text-slate-500">{practiceModule.skills.length} Kỹ năng trọng tâm</p>
    <h3 class="mt-1.5 text-xl font-black leading-snug text-slate-950 transition-colors group-hover:text-indigo-600 dark:text-slate-50 dark:group-hover:text-indigo-400">{practiceModule.title}</h3>
    <p class="mt-2.5 flex-1 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-400">{practiceModule.description}</p>
    <div class="mt-5 flex flex-wrap gap-1.5">
      {practiceModule.skills.slice(0, 3).map((skill) => <span class="rounded-xl bg-slate-100/90 dark:bg-slate-800 px-2.5 py-1 text-xs font-bold text-slate-600 dark:text-slate-300">{skill.icon} {skill.title}</span>)}
      {practiceModule.skills.length > 3 && <span class="rounded-xl bg-slate-100/90 dark:bg-slate-800 px-2 py-1 text-xs font-bold text-slate-500 dark:text-slate-400">+{practiceModule.skills.length - 3}</span>}
    </div>
    <span class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 text-sm font-black text-slate-700 transition-colors group-hover:text-indigo-600 dark:border-slate-800 dark:text-slate-200 dark:group-hover:text-indigo-400">
      <span>Luyện chủ đề này</span>
      <span class="text-base transition-transform group-hover:translate-x-1.5">→</span>
    </span>
  </a>
) : (
  <article class={`flex h-full flex-col rounded-[2rem] border border-slate-200/80 p-6 opacity-80 dark:border-slate-800 dark:bg-slate-900/90 ${surface}`}>
    <div class="flex items-start justify-between gap-4">
      <span class={`grid h-13 w-13 place-items-center rounded-2xl bg-gradient-to-br text-2xl text-white ${practiceModule.color}`}>{practiceModule.icon}</span>
      <span class="rounded-full bg-amber-50 border border-amber-200/70 px-3 py-1 text-xs font-black text-amber-700 dark:bg-amber-950/40 dark:border-amber-700/50 dark:text-amber-300">Sắp ra mắt</span>
    </div>
    <p class="mt-4 text-[11px] font-black tracking-wider text-slate-400 uppercase">Chủ đề {practiceModule.number}</p>
    <h3 class="mt-1.5 text-xl font-black text-slate-800 dark:text-slate-200">{practiceModule.title}</h3>
    <p class="mt-2.5 flex-1 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">{practiceModule.description}</p>
    <div class="mt-5 flex flex-wrap gap-1.5">
      {practiceModule.skills.slice(0, 3).map((skill) => <span class="rounded-lg bg-slate-100/80 dark:bg-slate-800 px-2.5 py-1 text-xs font-bold text-slate-600 dark:text-slate-300">{skill.icon} {skill.title}</span>)}
      {practiceModule.skills.length > 3 && <span class="rounded-lg bg-slate-100/80 dark:bg-slate-800 px-2 py-1 text-xs font-bold text-slate-500 dark:text-slate-400">+{practiceModule.skills.length - 3}</span>}
    </div>
    <div class="mt-6 rounded-2xl bg-slate-100/80 dark:bg-slate-800/80 px-5 py-3.5 text-center text-xs font-black text-slate-500 dark:text-slate-400">Đang chuẩn bị nội dung mở rộng</div>
  </article>
)}

