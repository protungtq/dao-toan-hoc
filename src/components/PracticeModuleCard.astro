---
interface Skill { icon: string; title: string }
interface Module {
  number: number; title: string; slug: string; description: string; icon: string;
  color: string; developmentStatus: string; textbookLessons: number[]; skills: Skill[];
}
interface Props { practiceModule: Module; grade: number; accent?: string; surface?: string }
const { practiceModule, grade, accent = 'group-hover:bg-violet-600', surface = 'bg-white' } = Astro.props;
const ready = practiceModule.developmentStatus === 'ready';
const href = `/luyen-tap/lop-${grade}/${practiceModule.slug}`;
const firstLesson = practiceModule.textbookLessons[0];
const lastLesson = practiceModule.textbookLessons[practiceModule.textbookLessons.length - 1];
---

{ready ? (
  <a href={href} class={`group relative flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 p-6 shadow-sm outline-none transition duration-200 hover:-translate-y-1 hover:border-violet-200 hover:shadow-xl focus-visible:ring-4 focus-visible:ring-violet-200 ${surface}`} aria-label={`Luyện ${practiceModule.title}`}>
    <div class={`absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r ${practiceModule.color}`}></div>
    <div class="flex items-start justify-between gap-4">
      <span class={`grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br text-2xl text-white shadow-lg transition group-hover:rotate-3 group-hover:scale-105 ${practiceModule.color}`}>{practiceModule.icon}</span>
      <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-extrabold text-emerald-700">Có thể luyện</span>
    </div>
    <p class="mt-5 text-xs font-extrabold tracking-wider text-slate-400">Mục {practiceModule.number} · Bài {firstLesson}–{lastLesson}</p>
    <h3 class="mt-2 text-xl font-black leading-snug text-slate-950 transition group-hover:text-violet-700">{practiceModule.title}</h3>
    <p class="mt-3 flex-1 font-medium leading-7 text-slate-500">{practiceModule.description}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {practiceModule.skills.slice(0, 3).map((skill) => <span class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">{skill.icon} {skill.title}</span>)}
      {practiceModule.skills.length > 3 && <span class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-500">+{practiceModule.skills.length - 3}</span>}
    </div>
    <span class={`mt-6 flex items-center justify-between rounded-2xl bg-slate-950 px-5 py-4 font-black text-white transition ${accent}`}><span>Bắt đầu luyện</span><span class="transition group-hover:translate-x-1">→</span></span>
  </a>
) : (
  <article class={`flex h-full flex-col rounded-[1.75rem] border border-slate-200 p-6 opacity-80 ${surface}`}>
    <div class="flex items-start justify-between gap-4"><span class={`grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br text-2xl text-white ${practiceModule.color}`}>{practiceModule.icon}</span><span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-extrabold text-amber-700">Đang xây dựng</span></div>
    <p class="mt-5 text-xs font-extrabold tracking-wider text-slate-400">Mục {practiceModule.number} · Bài {firstLesson}–{lastLesson}</p>
    <h3 class="mt-2 text-xl font-black text-slate-800">{practiceModule.title}</h3>
    <p class="mt-3 flex-1 font-medium leading-7 text-slate-500">{practiceModule.description}</p>
    <div class="mt-6 rounded-2xl bg-slate-100 px-5 py-4 text-center font-black text-slate-400">Đang chuẩn bị nội dung</div>
  </article>
)}
