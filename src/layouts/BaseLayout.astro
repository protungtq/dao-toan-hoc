---
import '../styles/global.css';
import SiteHead from '../components/SiteHead.astro';
import PwaControls from '../components/PwaControls.astro';
import TvNavigation from '../components/TvNavigation.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Nền tảng luyện tập Toán tiểu học trực quan và sinh động.',
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <SiteHead title={title} description={description} canonical={canonical} />
  </head>

  <body class="min-h-screen bg-[#f5f7fa] text-slate-900 antialiased transition-colors duration-300 dark:bg-slate-950 dark:text-slate-100">
    <slot />
    <TvNavigation />
    <PwaControls />
  </body>
</html>

<style is:global>
  :root {
    font-family:
      "Be Vietnam Pro", "Segoe UI", Arial, sans-serif;
  }

  html {
    scroll-behavior: smooth;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  ::selection {
    background: #c4b5fd;
    color: #312e81;
  }
</style>
